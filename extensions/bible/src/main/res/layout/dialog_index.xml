<?xml version="1.0" encoding="utf-8"?>
<!-- The index panel (arc 37 / B6) — the notebook Contents' dialog_contents.xml in a second
     subject: one layout for both forms — the panel owner branches in code on window width to pick
     full-screen vs. a left sidebar (panel width set from code; the back arrow shows only in the
     full-screen form). Header + divider · rows (paginated) · divider · pager. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/indexRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/indexPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/shape_index_sidebar"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnIndexBack"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/cd_bible_back" />

            <TextView
                android:id="@+id/indexTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/bible_index_title"
                android:textColor="@color/inkBlack"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <FrameLayout
            android:id="@+id/indexBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/indexRows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <LinearLayout
            android:id="@+id/indexPager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnIndexFirst"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="@string/cd_bible_index_first" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnIndexPrev"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_bible_index_prev" />

            <TextView
                android:id="@+id/indexPageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/inkBlack" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnIndexNext"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_bible_index_next" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnIndexLast"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_last"
                android:contentDescription="@string/cd_bible_index_last" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
