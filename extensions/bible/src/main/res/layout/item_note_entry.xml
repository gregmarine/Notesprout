<?xml version="1.0" encoding="utf-8"?>
<!-- One Notes row (arc 42 "Notes" / N1): item_recent_entry.xml's two lines in this subject — the
     place the user wrote ("Study · Page 4", 20sp), then what it says about this scope and when
     ("John 3:14–18; Proverbs 3:5–6 · 14 Sep 2026", 13sp). Both inkBlack: the lower line carries
     information, and SN's palette rule makes secondary text *smaller*, never grey. The detail
     line is one line like the Recents row's — a row that could wrap would break the measured,
     uniform row height the pagination divides by — so a page naming many references ellipsizes.
     1dp separator below, inset like the Recents row's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noteEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/noteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/inkBlack"
            android:textSize="20sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/noteDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/inkBlack"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:background="@color/inkBlack" />

</LinearLayout>
