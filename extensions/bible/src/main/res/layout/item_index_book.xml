<?xml version="1.0" encoding="utf-8"?>
<!-- Index book row (arc 37 / B6): the Contents' item_contents_entry.xml with the page number's
     slot holding the book's chapter count — [+/− toggle] [count 52dp] [1dp divider] [name],
     min height 68dp, 1dp separator below. The book being read takes bg_index_active_entry
     (5dp bar, right edge). The whole row is the toggle; the glyph says which way it goes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/indexEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnToggle"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/cd_bible_expand" />

        <TextView
            android:id="@+id/entryCount"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/inkBlack" />

        <TextView
            android:id="@+id/entryLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/inkBlack"
            android:textSize="20sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:background="@color/inkBlack" />
</LinearLayout>
