<?xml version="1.0" encoding="utf-8"?>
<!--
  The extension's own strings. `ok` and `cancel` come from :sn-screen (Dialogs / ActionSheetDialog
  reference them from inside the module) and are deliberately not repeated here.
-->
<resources>
    <string name="ext_label">NSE · Bible</string>

    <!-- Every icon button needs a long-press hint naming it, and the hint is its content description. -->
    <string name="cd_bible_back">Back</string>
    <string name="cd_bible_contents">Contents</string>
    <string name="cd_bible_recents">Recents</string>
    <!-- A text button, not a glyph: there is no icon for "the whole chapter this came from". -->
    <string name="bible_full_chapter">Full chapter</string>
    <string name="cd_bible_prev_page">Previous page</string>
    <string name="cd_bible_next_page">Next page</string>

    <!-- The Contents panel (arc 37 / B6, renamed from "Index" by B7): the notebook Contents' shape — book rows that open into a
         chapter grid, paginated, with the library-shape pager below. -->
    <string name="bible_contents_title">Contents</string>
    <string name="cd_bible_expand">Show chapters</string>
    <string name="cd_bible_collapse">Hide chapters</string>
    <string name="cd_bible_contents_first">First page</string>
    <string name="cd_bible_contents_prev">Previous page</string>
    <string name="cd_bible_contents_next">Next page</string>
    <string name="cd_bible_contents_last">Last page</string>

    <!-- The Recents panel (arc 37 / B7, grown by arc 38 / R2): the notebook Recents' shape,
         mirrored to the right — the chapters picked from the Contents AND the passages followed
         from a notebook, newest first; its pager reuses the Contents' hints. The wording lost the
         word "chapters" when references joined the list. -->
    <string name="bible_recents_title">Recents</string>
    <string name="bible_recents_empty">No recents</string>
    <!-- "<medium date>, <time>" — when a chapter or a passage was opened. -->
    <string name="bible_recents_when">%1$s, %2$s</string>

    <string name="bible_title">Bible</string>
    <string name="bible_page_indicator">%1$d / %2$d</string>
    <!-- Book name + chapter number, the reader's top-bar title (e.g. "Genesis 1"). -->
    <string name="bible_chapter_title">%1$s %2$d</string>
    <string name="bible_loading">Loading\u2026</string>

    <string name="bible_unavailable_title">Bible unavailable</string>
    <string name="bible_unavailable_body">This chapter could not be opened. Close the Bible and open it again.</string>
    <!-- The passage view's half of the same failure (arc 38 / R2). -->
    <string name="bible_passage_unavailable_body">This passage could not be opened. Close the Bible and open it again.</string>
</resources>
