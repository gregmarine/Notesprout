<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No launcher activity: the Supernote launcher lists the package anyway (accepted — "Ratta
         being Ratta"); everywhere else only Settings → Apps shows it. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ext_label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout">

        <!-- The BIBLE point (arc 37 / B0) — SN's NINTH capability point, the fifth screen-owning
             one and the second with no paper (the tag manager's shape): a held bind for the
             showing, `begin(store)` lends the store once, `end()` drops it. No Application class:
             this extension has no drawing engine to register.
             API version 11 — born here, listed only at `MIN_API_VERSION_FOR_BIBLE`, because the
             point was never reachable at any lower number. **12 since arc 38 / R1**: `resolve` +
             `beginAt` behind the method floor `MIN_API_VERSION_FOR_BIBLE_REFERENCE`; the host
             offers the notebook's reference doors only to a reader declaring it. The
             `android:value` below is the host-compat gate — it is the line that matters, and
             this comment must move with it. -->
        <service
            android:name=".BibleService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.BIBLE" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="12" />
        </service>

        <!-- The extension-owned screen (tier 2): exported, custom action, NO launcher filter;
             launched only by the host for a result — it verifies its caller first thing in
             onCreate. <category DEFAULT> is required or implicit resolution will not match it.
             No windowSoftInputMode / configChanges: this screen has no text entry, so there is no
             field to strand under a hardware-keyboard config change and no IME to keep shown. -->
        <activity
            android:name=".BibleActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.BIBLE_SCREEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
