    <string name="sketch_not_saved_title">Sketch not saved</string>
    <string name="sketch_not_saved_body">Notesprout SN could not save this page\'s sketch.</string>
    <string name="sketch_try_again">Try again</string>
    <string name="sketch_leave_anyway">Leave anyway</string>
