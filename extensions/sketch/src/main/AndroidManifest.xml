<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No launcher activity: the Supernote launcher lists the package anyway (accepted — "Ratta
         being Ratta"); everywhere else only Settings → Apps shows it. -->
    <application
        android:name=".SketchApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ext_label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout">

        <!-- The SKETCH point (arc 43 / K5) — SN's TENTH capability point (granted by the user
             2026-09-15), the sixth screen-owning one and the third with paper: a raster pencil
             sketch surface over g-paper, beside the ink rather than mixed into it. `ISketch.begin
             (host)` lends the host for the whole showing, `end()` drops it — there is NO store:
             the pixels live in the host's own `.soil` and cross the seam as chunked lossless WebP
             — two rasters a page since arc 45 "Ink" — so this point never touches Room / SQLCipher
             / serialization. **API version 21 since arc 46 "Palette" / Q1** — the number is what
             this extension REQUIRES OF THE HOST: 21 is
             `SketchContract.MIN_API_VERSION_FOR_SKETCH_PEN_SHADE`, the parcel tail that carries the
             gel pen's remembered shade (`SketchToolSettings.penShade`, a fourth int a 20 host
             would read as absent). The ACTION floor `MIN_API_VERSION_FOR_SKETCH` is still 20, where
             G2 moved it from 17: the point's own calls changed
             shape in place — `ISketchHost.readSketchChunk` / `saveSketchChunk` (codes 3–4) took a
             raster layer, and `SketchPageState`'s wire form grew a second byte/chunk pair — so
             neither side can read the other's, and a host below 20 never discovers this package at
             all. That discovery gate is the whole guard; there is no runtime version test
             anywhere in this extension. The two method floors beneath it are history and inert:
             `MIN_API_VERSION_FOR_SKETCH_PAGES` 18 (K5b's five page tails) and
             `MIN_API_VERSION_FOR_SKETCH_TOOLS` 19 (arc 44 / T2's two tool tails) are both below
             the action floor now, so every host that can bind at all already clears them. The
             `android:value` below is the host-compat gate — it is the line that matters, and this
             comment must move with it. -->
        <service
            android:name=".SketchService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.SKETCH" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="21" />
        </service>

        <!-- The extension-owned screen (tier 2): exported, custom action, NO launcher filter;
             launched only by the host for a result — it verifies its caller first thing in
             onCreate. <category DEFAULT> is required or implicit resolution will not match it.
             A paper screen like the pad's: nothing rides the Intent but `EXTRA_CHROME_HIDDEN`. -->
        <activity
            android:name=".SketchActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.SKETCH_SCREEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
