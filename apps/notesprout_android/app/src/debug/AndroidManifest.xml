<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- HWR Lab: debug-only eval harness for the TrOCR engine (Phase 0 go/no-go).
             exported=true so it can be launched without touching production UI:
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.HwrLabActivity -->
        <activity
            android:name="com.notesprout.android.HwrLabActivity"
            android:exported="true"
            android:label="HWR Lab" />
        <!-- Crypto Spike: debug-only Phase-0 harness measuring SQLCipher open latency on
             real notebooks (global-encryption go/no-go). Scratch for the spike; reverted after.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.CryptoSpikeActivity -->
        <activity
            android:name="com.notesprout.android.debug.CryptoSpikeActivity"
            android:exported="true"
            android:label="Crypto Spike" />
        <!-- Colour Ink Spike: debug-only harness for colour ink on a Kaleido panel.
             Phase-0 findings (NoteAir5C, 2026-07-31): the raw-drawing overlay DOES render colour;
             a colour change needs no restartRawDrawing; the first-stroke fast-mode app-scope
             (HAND_WRITING_REPAINT_MODE) does NOT suppress it; getColorType()=1 via SDMDevice.
             13 of 14 probe colours rendered live — the sole failure, #1E7A34, sits below an
             observed **brightness floor of ~180 in the dominant channel** (every survivor was
             ≥184). Retained past Phase 0 as the palette-calibration tool: cycle Ink through the
             probe set to re-measure that floor against real writing.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.ColorInkSpikeActivity -->
        <activity
            android:name="com.notesprout.android.debug.ColorInkSpikeActivity"
            android:exported="true"
            android:label="Color Ink Spike" />
        <!-- Pen Tool Spike: the on-device half of docs/onyx-pen-tools.md. Walks all 9 overlay
             stroke styles (path A, firmware) against all 13 software renderers (path B, NeoPen),
             and reports pressure/tilt actually observed per stroke.
             Findings (NoteAir5C, 2026-08-01): ALL 9 overlay styles render and are visually
             distinct — including DASH/CHARCOAL_V2/SQUARE_PEN, which sit past EpdController's own
             constant list; no silent failures. setStrokeStyle needs no restartRawDrawing and
             survives the HAND_WRITING_REPAINT_MODE fast-mode pin. Pressure is a real full-range
             1..4095 channel (tilt too) already arriving on points production discards. All 13
             software renderers work — libneopen_jni.so loads in a third-party app — and several
             are FASTER than our polyline. Two traps: ResManager.init(context) is mandatory before
             any bitmap-backed pen (pencil otherwise renders solid+grainless, then throws on
             rebuild), and texture pens need large widths or their grain does not exist.
             G102 (2026-08-02) confirms all 9 styles + all 13 renderers, no failures; note
             getMaxTouchPressure differs per device (4095 NA5C vs 4096 G102) so never hardcode it.
             Timings in the doc are single cold renders and warmup-dominated — not a benchmark.
             G6 (2026-08-03) also confirms all 9 styles + all 13 renderers. Two further findings:
             tilt is NOT on a common scale across devices (G6 reports ~100x larger than NA5C/G102,
             no getMaxTilt to normalize against), and the one-call *Wrapper.drawStroke helpers
             create+destroy a native pen per invocation, so they are fine one-off but pathological
             in a page repaint — use a cached NeoPen in a NeoPenRender there.
             MAX (2026-08-03) makes it 4/4 devices: every style and every renderer works on all of
             NA5C/G102/G6/MAX. Only maxTouchPressure (4095 vs 4096) and tilt scale vary per device.
             P2P (2026-08-03) completes the sweep: 5/5 devices, every style and every renderer, no
             failure anywhere. P2P also shows colorType is NOT a boolean (it reports 1017, vs 0/1
             elsewhere) and needs compact chrome at sw439dp.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.PenToolSpikeActivity -->
        <activity
            android:name="com.notesprout.android.debug.PenToolSpikeActivity"
            android:exported="true"
            android:label="Pen Tool Spike" />
        <!-- Today Seed: writes (and removes) dashboard test data — the shape a real library rarely
             has on any one day: enough rows to paginate, routine steps that surface outside their
             routine, a routine with one open step so ticking it rolls it forward, and rows resolved
             today that should stay in place ticked.
             Every row is titled "[TEST] …" and CLEAR removes exactly those, hard-deleted so no
             tombstone is left inside a series. Writes through the app's own open index, never the
             database file.

             Actions, passed as a string extra "action": full | minimal | clear | open | probe | raw
             ("raw" also takes a "target" extra: tasks | calendar | main | today).

             "open" launches the dashboard, which is exported="false" and so unreachable from a shell
             am start — this is the same UID, so the export check doesn't apply, and no production
             manifest is weakened to make layout work possible.

             "probe" and "raw" are the diagnostics behind the BACKLOG item "Surfaces crash when
             Android rebuilds a task with the index closed" (found 2026-08-04). In a fresh process,
             with the index never opened, ALL SEVEN repositories throw
             (Tasks/Today/Events/Calendar/Scratchpad/DayHistory/Index), and raw+target=tasks
             reproduces the crash in TasksActivity. Only BootstrapActivity ever opens the index, and
             it finishes itself, so an OS task rebuild after a background kill re-runs nothing.
             TodayActivity is guarded; the rest are not.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.TodaySeedActivity -->
        <activity
            android:name="com.notesprout.android.debug.TodaySeedActivity"
            android:exported="true"
            android:label="Today Seed" />
        <!-- Supernote Probe: the permanent Ratta calibration tool (built as Phases 0-1 of the
             retired SUPERNOTE_SUPPORT_PLAN.md; the as-built engine is documented in
             docs/drawing-engine.md, Ratta section).
             Runtime binder handshake, eink-service reflection check, pen tool-type/pressure/
             tilt readout, live firmware ink write area (setup re-asserted on window focus), the
             0…31 pen-type sweep at EMR 300 (hunting a dashed style for Phase 5), and disable-area
             tests (chrome always excluded; STRIP toggles a dashed test band).
             Findings (2026-08-08, Nomad SN078D10012852 + Manta SN100C10023972, both ending on
             firmware Chauvet.E103.2606141001.2389): binder service_myservice alive on both
             (service.myservice alias absent); eink=android.os.EinkManager with enableFullUiAuto;
             pen=TOOL_TYPE_STYLUS, eraser end=TOOL_TYPE_ERASER, finger=TOOL_TYPE_FINGER (no ink),
             all with dense point streams + real pressure/tilt. Live NEEDLE ink "fantastic";
             clearAll ghost-free; disable-area boundary exact; focus re-assert works after Home.
             The firmware natively erases ITS OWN overlay ink under the eraser end without
             setEraser (colour-255 payload, not the type code, is what makes a real eraser).
             Ink path SURVIVED a firmware update (2347→2389) mid-test. Pen-code sweep 0…31 at
             EMR 300: 0/5/8/10/11 solid steady; 1/2/16 pressure-sensitive (codes 17–31 all alias
             to 16, so the table ends at 16); 3 = stream of tiny x's (Supernote's lasso-eraser
             trail); 4 = STREAM OF DASHES (lasso selector) — the hardware dashed style that
             unlocks Phase 5; 12 renders but sometimes emits a giant laggy blob (broken, never
             use); 6/7/9/13 render nothing; 14 possibly calligraphy, 15 calligraphy.
             Phase 8 additions: REG lab (dual-render registration measurement — app twin of
             each stroke at raw MotionEvent coords over the uncleared overlay, X/Y nudge to
             null; feeds RattaNotebookView.REG_OFFSET_X_PX) and COL (cycles the four firmware
             colour codes to calibrate RattaInkMap's grey thresholds).
             Keep this activity as the Ratta calibration tool (like PenToolSpikeActivity).
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.SupernoteProbeActivity -->
        <activity
            android:name="com.notesprout.android.debug.SupernoteProbeActivity"
            android:exported="true"
            android:label="Supernote Probe" />
        <!-- Nib Probe: cross-device hover experiment — can a small "current tool" badge be
             drawn near the pen nib from the HOVER stream, before the tip lands? (The friction:
             with the toolbar hidden the armed tool is invisible until it marks the page.)
             Arms the real ink layer per device (Ratta firmware full-UI ink at the engine's
             NEEDLE/EMR-250 · BOOX TouchHelper raw drawing · app polyline elsewhere) so badge
             visibility and interference are measured under real pen conditions. Measures hover
             delivery per source (view hover / generic / BOOX onPenActive), AXIS_DISTANCE range,
             the ENTER→DOWN warning window (last + median), badge invalidate→draw latency, and
             whether the hide-at-contact repaint survives (Ratta overlay law 2 territory).
             TOOL / MODE (follow · enter-only · off) / POS (above · up-left · up-right) / INK /
             CLEAR.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.NibProbeActivity -->
        <activity
            android:name="com.notesprout.android.debug.NibProbeActivity"
            android:exported="true"
            android:label="Nib Probe" />
        <!-- Reveals the global passphrase so the encrypted index stays sqlcipher-inspectable. Debug only.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.DebugKeyActivity -->
        <activity
            android:name="com.notesprout.android.debug.DebugKeyActivity"
            android:exported="true"
            android:label="Debug Key" />
    </application>
</manifest>
