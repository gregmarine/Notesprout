<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- HWR Lab: debug-only eval harness for the TrOCR engine (Phase 0 go/no-go).
             exported=true so it can be launched without touching production UI:
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.HwrLabActivity -->
        <activity
            android:name="com.notesprout.android.HwrLabActivity"
            android:exported="true"
            android:label="HWR Lab" />
        <!-- Crypto Spike: debug-only Phase-0 harness measuring SQLCipher open latency on
             real notebooks (global-encryption go/no-go). Scratch for the spike; reverted after.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.CryptoSpikeActivity -->
        <activity
            android:name="com.notesprout.android.debug.CryptoSpikeActivity"
            android:exported="true"
            android:label="Crypto Spike" />
        <!-- Colour Ink Spike: debug-only harness for colour ink on a Kaleido panel.
             Phase-0 findings (NoteAir5C, 2026-07-31): the raw-drawing overlay DOES render colour;
             a colour change needs no restartRawDrawing; the first-stroke fast-mode app-scope
             (HAND_WRITING_REPAINT_MODE) does NOT suppress it; getColorType()=1 via SDMDevice.
             13 of 14 probe colours rendered live — the sole failure, #1E7A34, sits below an
             observed **brightness floor of ~180 in the dominant channel** (every survivor was
             ≥184). Retained past Phase 0 as the palette-calibration tool: cycle Ink through the
             probe set to re-measure that floor against real writing.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.ColorInkSpikeActivity -->
        <activity
            android:name="com.notesprout.android.debug.ColorInkSpikeActivity"
            android:exported="true"
            android:label="Color Ink Spike" />
        <!-- Pen Tool Spike: the on-device half of docs/onyx-pen-tools.md. Walks all 9 overlay
             stroke styles (path A, firmware) against all 13 software renderers (path B, NeoPen),
             and reports pressure/tilt actually observed per stroke.
             Findings (NoteAir5C, 2026-08-01): ALL 9 overlay styles render and are visually
             distinct — including DASH/CHARCOAL_V2/SQUARE_PEN, which sit past EpdController's own
             constant list; no silent failures. setStrokeStyle needs no restartRawDrawing and
             survives the HAND_WRITING_REPAINT_MODE fast-mode pin. Pressure is a real full-range
             1..4095 channel (tilt too) already arriving on points production discards. All 13
             software renderers work — libneopen_jni.so loads in a third-party app — and several
             are FASTER than our polyline. Two traps: ResManager.init(context) is mandatory before
             any bitmap-backed pen (pencil otherwise renders solid+grainless, then throws on
             rebuild), and texture pens need large widths or their grain does not exist.
             G102 (2026-08-02) confirms all 9 styles + all 13 renderers, no failures; note
             getMaxTouchPressure differs per device (4095 NA5C vs 4096 G102) so never hardcode it.
             Timings in the doc are single cold renders and warmup-dominated — not a benchmark.
             Retained as the tool for sweeping the remaining Tier-1 devices (G6, MAX, P2P).
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.PenToolSpikeActivity -->
        <activity
            android:name="com.notesprout.android.debug.PenToolSpikeActivity"
            android:exported="true"
            android:label="Pen Tool Spike" />
        <!-- Reveals the global passphrase so the encrypted index stays sqlcipher-inspectable. Debug only.
             adb shell am start -n com.notesprout.android.dev/com.notesprout.android.debug.DebugKeyActivity -->
        <activity
            android:name="com.notesprout.android.debug.DebugKeyActivity"
            android:exported="true"
            android:label="Debug Key" />
    </application>
</manifest>
