<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".NotesproutApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notesprout">

        <!-- Launcher entry point: prepares (and, first launch, encrypts) the index before any UI,
             then forwards to MainActivity so its cold-launch surface restore runs unchanged. -->
        <activity
            android:name=".BootstrapActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Notesprout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateHidden">
            <!-- Tap a .soil file — path-pattern match covers any MIME type the file manager sends -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.soil" />
            </intent-filter>
            <!-- Explicit MIME type fallbacks for file managers that set them -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-notesprout-soil" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="application/x-notesprout-soil" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Share a .soil to Notesprout -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-notesprout-soil" />
            </intent-filter>
            <!-- Share a .soil to Notesprout (older exports / other sources) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Tap or share a text/Markdown file — imports as a text document
                 (see docs/documents.md § Text documents). The .soil filters above
                 don't match these: their pathPattern is .soil-only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="file" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Calendar — full-screen date navigation screen, launchable from MainActivity and NotebookActivity -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Day detail — full-screen single-page handwriting canvas for one calendar day -->
        <activity
            android:name=".DayDetailActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!--
            Today — the dashboard: a focus view of the day and the jump point for the rest of the
            app. No drawing surface, so it may recreate freely on rotation/resize; it simply
            recomputes how many rows fit per page.
        -->
        <activity
            android:name=".TodayActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Tasks — the to-do surface, a sibling of the calendar and the scratch pad -->
        <activity
            android:name=".TasksActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Routine — one routine occurrence and its steps, opened from the Tasks list -->
        <activity
            android:name=".RoutineActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Notebook screen — prevent recreation on rotation/resize so bitmap survives.
             `keyboard` matters too: attaching a Bluetooth keyboard is a keyboard config change, and
             this activity is the document editor's host — destroying it behind the editor clears
             DocumentTransfer.host and seals the .soil, leaving the editor with "The notebook is no
             longer open." until the user backs out. -->
        <activity
            android:name=".NotebookActivity"
            android:exported="false"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Page index screen — full-screen grid of page snapshots -->
        <activity
            android:name=".PageIndexActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Recognized-text viewer — read-only handwriting-to-text (This Page / Whole Notebook) -->
        <activity
            android:name=".PageTextViewerActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Markdown document editor — full-screen Markdown writing surface + rendered preview.
             `keyboard` is in configChanges so pairing a physical keyboard does not recreate the
             activity (an unsaved draft would go with it); the soft-keyboard decision is re-made in
             onConfigurationChanged instead. Soft input is driven from code, hence stateUnchanged. -->
        <activity
            android:name=".DocumentEditorActivity"
            android:exported="false"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateUnchanged|adjustResize" />

        <!-- Notebook picker — folder-browse list for cross-notebook page copy/move destination -->
        <activity
            android:name=".NotebookPickerActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Link target picker — full-screen chrome + page-thumbnail grid -->
        <activity
            android:name=".LinkTargetPickerActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Template browser — full-screen folder/template grid (manage + pick modes) -->
        <activity
            android:name=".TemplateBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.Notesprout"
            android:windowSoftInputMode="stateHidden" />

        <!-- First-launch onboarding — reveals the recovery key before the library opens -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateHidden" />

        <!-- Encryption settings — global passphrase management (status, forget, change) -->
        <activity
            android:name=".EncryptionSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <!-- Handwriting Recognition settings — engine toggle (ML Kit / TrOCR) + model bundles -->
        <activity
            android:name=".HwrSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <!-- Handwriting enrollment — copy prescribed sentences to seed the personal model -->
        <activity
            android:name=".HwrEnrollmentActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <!-- Backup settings — local + Google Drive destination configuration -->
        <activity
            android:name=".BackupSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Notesprout"
            android:windowSoftInputMode="stateHidden" />

        <!-- Export screen — format, options, and destination for every export entry point -->
        <activity
            android:name=".ExportActivity"
            android:exported="false"
            android:theme="@style/Theme.Notesprout"
            android:windowSoftInputMode="stateHidden" />

        <!-- Drive OAuth WebView — opens Google consent page, intercepts localhost redirect -->
        <activity
            android:name=".DriveAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Notesprout"
            android:windowSoftInputMode="stateHidden" />

        <!-- Scratch pad — translucent floating window over any launch surface -->
        <activity
            android:name=".ScratchpadActivity"
            android:exported="false"
            android:theme="@style/Theme.Notesprout.Scratchpad"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- Sticky note editor — translucent in-memory popup over NotebookActivity -->
        <activity
            android:name=".StickyNoteEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Notesprout.Scratchpad"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="stateHidden" />

        <!-- FileProvider — exposes cacheDir PDF exports to the share sheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
