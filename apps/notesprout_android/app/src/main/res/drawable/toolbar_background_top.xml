<?xml version="1.0" encoding="utf-8"?>
<!-- Top-anchored toolbar: white background with 1dp inkBlack top AND bottom (inner) borders.
     The bar no longer sits flush against the screen edge — it starts below the top guard band
     (see TopGuard), so its top edge needs a border of its own to read as a bar.
     Negative left/right insets push the stroke rect outside the view bounds on those sides
     so only the top and bottom edges of the stroke are visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paperWhite" />
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/inkBlack" />
        </shape>
    </item>
</layer-list>
