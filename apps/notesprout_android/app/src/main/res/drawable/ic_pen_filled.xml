<?xml version="1.0" encoding="utf-8"?>
<!-- Tabler "pencil" icon, FILLED variant (filled/pencil.svg).

     The one filled glyph in an otherwise outline-only set, and deliberately so: this icon is tinted
     with the pen's current ink (see PenColorPanelController.applyPenTint), and an outline stroke has
     too little pixel area to read as a colour on a Kaleido panel, where colours are already muted.
     The fill is the whole point — it is what makes the armed ink legible at a glance.

     Used only by the pen TOOL buttons on the five drawing surfaces. The outline `ic_pen` stays in
     use for the document editor's Write/Preview mode toggle, which carries no ink. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/inkBlack"
        android:pathData="M12.085 6.5l5.415 5.415l-8.793 8.792a1 1 0 0 1 -.707 .293h-4a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 .293 -.707zm5.406 -2.698a3.828 3.828 0 0 1 1.716 6.405l-.292 .293l-5.415 -5.415l.293 -.292a3.83 3.83 0 0 1 3.698 -.991"/>
</vector>
