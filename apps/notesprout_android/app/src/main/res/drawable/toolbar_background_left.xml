<?xml version="1.0" encoding="utf-8"?>
<!-- Left-anchored toolbar: white background with 1dp inkBlack right AND top (inner) borders.
     The bar starts below the top guard band (see TopGuard) rather than at the screen edge,
     so its top edge needs a border of its own.
     Negative left/bottom insets push the stroke rect outside the view bounds on those sides
     so only the right and top edges of the stroke are visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paperWhite" />
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/inkBlack" />
        </shape>
    </item>
</layer-list>
