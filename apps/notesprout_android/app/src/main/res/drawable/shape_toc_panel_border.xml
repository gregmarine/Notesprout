<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top inset stays in bounds so the panel's top edge is bordered: the panel starts below the
         top guard band (see TopGuard), not at the screen edge. -->
    <item android:bottom="-2dp" android:left="-4dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/inkBlack" />
            <solid android:color="@color/paperWhite" />
        </shape>
    </item>
</layer-list>
