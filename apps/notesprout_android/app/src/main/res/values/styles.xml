<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Typography ── -->

    <!-- Base required by AAPT2 for dot-notation implicit parent chain -->
    <style name="TextAppearance.Notesprout" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Notesprout.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkLight</item>
    </style>

    <style name="TextAppearance.Notesprout.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <!-- ── Buttons ── -->

    <!-- Black fill, white text, 4dp radius, no elevation, no press effect -->
    <style name="Widget.Notesprout.ElevatedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_elevated_background</item>
        <item name="android:textColor">@color/paperWhite</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- White fill, black text, 1dp black stroke, 4dp radius, no press effect -->
    <style name="Widget.Notesprout.OutlinedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/shape_bordered</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Toolbar icon button — square tap target sized by @dimen/toolbar_button_size
         (44dp under sw720dp, 62dp on tablets to match the Supernote native toolbar), padded so
         the icon has breathing room. Selected state shows border. -->
    <style name="Widget.Notesprout.ToolbarButton" parent="">
        <item name="android:layout_width">@dimen/toolbar_button_size</item>
        <item name="android:layout_height">@dimen/toolbar_button_size</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:padding">@dimen/toolbar_button_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Selectable text toggle button — bg_toolbar_button selector (border on selected),
         toolbar-button height, wrap-width text. Used by the Before/After move/copy toggle in the
         page index. -->
    <style name="Widget.Notesprout.ToggleTextButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/toolbar_button_size</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Full-width selectable option row (export screen). Same bg_toolbar_button selector as the
         toggle button — border appears on the selected row, which is how a radio choice reads on
         e-ink without any tint or fill. -->
    <style name="Widget.Notesprout.OptionRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/toolbar_button_size</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Section heading on a settings-style screen. -->
    <style name="Widget.Notesprout.SectionHeading" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Checkbox row on a settings-style screen (matches the backup-settings pattern). -->
    <style name="Widget.Notesprout.OptionCheck" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/toolbar_button_size</item>
        <item name="android:buttonTint">@color/inkBlack</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <!-- Transparent background, black text, no press effect -->
    <style name="Widget.Notesprout.TextButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

</resources>
