<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!--
        Picker toolbar: shown only in destination picker mode (Copy/Move notebook or folder).
        Hidden by default; VISIBLE when destinationPickerState != None.
    -->
    <LinearLayout
        android:id="@+id/pickerToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPickerCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Cancel"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:background="@null"
            android:stateListAnimator="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:gravity="center" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPickerConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Copy here"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:textStyle="bold"
            android:background="@null"
            android:stateListAnimator="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </LinearLayout>

    <View
        android:id="@+id/pickerToolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack"
        android:visibility="gone" />

    <!--
        Pinned toolbar: shown only in pinned browse mode.
        Hidden by default; VISIBLE when isPinnedMode is true.
    -->
    <LinearLayout
        android:id="@+id/pinnedToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/pinnedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="Pinned"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPinnedCancel"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_x"
            android:contentDescription="Exit pinned view" />

    </LinearLayout>

    <View
        android:id="@+id/pinnedToolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack"
        android:visibility="gone" />

    <!--
        Recents toolbar: shown only in recents browse mode.
        Hidden by default; VISIBLE when isRecentsMode is true.
    -->
    <LinearLayout
        android:id="@+id/recentsToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/recentsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="Recent Notebooks"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRecentsCancel"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_x"
            android:contentDescription="Exit recents view" />

    </LinearLayout>

    <View
        android:id="@+id/recentsToolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack"
        android:visibility="gone" />

    <!--
        Search toolbar: shown only in search mode.
        Hidden by default; VISIBLE when isSearchMode is true.
    -->
    <LinearLayout
        android:id="@+id/searchToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/searchTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSearchInToolbar"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_search"
            android:contentDescription="Search notebooks" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnClearSearch"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_x"
            android:contentDescription="Clear search" />

    </LinearLayout>

    <View
        android:id="@+id/searchToolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack"
        android:visibility="gone" />

    <!--
        Breadcrumb bar: always visible for consistent layout.
        Back button and chips are hidden at root; chips populate when navigated into a subfolder.
    -->
    <LinearLayout
        android:id="@+id/breadcrumbBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBreadcrumbBack"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Go up one folder"
            android:visibility="invisible" />

        <!-- 1dp vertical divider between back button and breadcrumb chips -->
        <View
            android:id="@+id/breadcrumbBackDivider"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/inkBlack"
            android:visibility="invisible" />

        <HorizontalScrollView
            android:id="@+id/breadcrumbScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/breadcrumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPinned"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_pinned"
            android:contentDescription="Pinned notebooks" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSearch"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_search"
            android:contentDescription="Search notebooks" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRecents"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_clock"
            android:contentDescription="Recent notebooks" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSort"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_filter"
            android:contentDescription="Sort" />

    </LinearLayout>

    <!-- 1dp separator below breadcrumb bar — always visible since the bar is always visible -->
    <View
        android:id="@+id/breadcrumbDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!--
        Grid area: fills all vertical space above the bottom bar.
        Cards and the empty-state message are added programmatically.
    -->
    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
        Overflow toolbar: secondary row shown when btnMore is tapped.
        Contains Import, Templates, and Encryption — right-aligned to mirror the bottom bar.
        Hidden by default; toggled by btnMore.
    -->
    <View
        android:id="@+id/overflowToolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overflowToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical|end"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnImport"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_import"
            android:contentDescription="Import Notebook" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnTemplates"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_template"
            android:contentDescription="Templates" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnEncryption"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Encryption" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnHwr"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_text_recognition"
            android:contentDescription="Handwriting Recognition" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackup"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_backup"
            android:contentDescription="Backup" />

        <!-- TEMP: legacy-ts compaction sweep — remove after all devices compacted (see BACKLOG.md) -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCompact"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_compact"
            android:contentDescription="Compact Notebooks" />

        <!--
            Today and Tasks both live in the overflow row here. The wider variants put Today in
            surfaceButtonsGroup beside Calendar and Scratch Pad, but the bottom bar in this bucket is
            already at 428dp of the Palma2 Pro's 439dp and cannot absorb another 48dp — for either
            of them.

            The row itself has room: eight buttons come to 44×8 + 4×7 + 16 = 396dp of 439dp.

            Both ids must still exist in EVERY variant of this layout or view binding makes the
            fields nullable — same reason the pagination buttons stay in the tree here (see the
            bottom-bar comment below). MainActivity therefore wires them once, with no per-variant
            branch.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnToday"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_layout_dashboard"
            android:contentDescription="Today" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnTasks"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_tasks"
            android:contentDescription="Tasks" />

    </LinearLayout>

    <!--
        Bottom bar (sw360dp variant): sibling-surface buttons at the start, pagination anchored
        directly after them, action buttons right-aligned.

        Width budget — the tightest device in this bucket is the Palma2 Pro at 439dp
        (824px @ density 300); the Go 6 Gen II is 571dp and has room to spare:
            surface     16 + 44 + 4 + 44            = 108dp
            pagination  44 + 4 + 72 (n/n) + 44      = 164dp   (first/last dropped, see below)
            actions     44 + 4 + 44 + 4 + 44 + 16   = 156dp
                                                    = 428dp of 439dp
        With first/last-page shown this comes to 520dp and overflows, so those two are gone here.
        There is likewise no room to centre the pagination group once the action buttons are
        present, so it is anchored to the end of the surface group instead.
        Height @dimen/toolbar_bar_thickness — matches the notebook activity toolbar for uniformity.
    -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:background="@color/paperWhite">

        <!-- Top border (1dp inkBlack) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack"
            android:layout_alignParentTop="true" />

        <!--
            Sibling-surface buttons: Calendar + Scratch Pad, left-aligned.
            These are places to go, not library actions — hence their own zone, opposite the
            create/overflow group. The bottom bar is the only chrome that is never swapped out by
            search / pinned / recents mode, so one button each here is always reachable and needs
            no per-mode duplicate. Hidden only in destination-picker mode.
        -->
        <LinearLayout
            android:id="@+id/surfaceButtonsGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnCalendar"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Calendar" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnScratchpad"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_sketching"
                android:contentDescription="Scratch Pad" />

        </LinearLayout>

        <!--
            Pagination group: |<  <  n/n  >  >|
            Anchored after the surface group on narrow screens so the two do not overlap.
        -->
        <LinearLayout
            android:id="@+id/paginationGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_toEndOf="@id/surfaceButtonsGroup"
            android:layout_centerVertical="true"
            android:gravity="center_vertical">

            <!--
                First/last-page jumps are dropped on narrow screens to make room for the surface
                buttons — prev/next plus the n/n readout still cover paging. Kept in the tree (not
                deleted) so the view-binding fields stay non-null across all layout variants;
                MainActivity only ever sets isEnabled on these, never visibility.
            -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFirstPage"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="First page"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrevPage"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="Previous page" />

            <TextView
                android:id="@+id/tvPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/inkBlack"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1/1" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNextPage"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="Next page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnLastPage"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_page_last"
                android:contentDescription="Last page"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right-side action buttons: New Notebook + New Folder + More, right-aligned -->
        <LinearLayout
            android:id="@+id/actionButtonsGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNewNotebook"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_new_notebook"
                android:contentDescription="New notebook" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNewFolder"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_folder_plus"
                android:contentDescription="New folder" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMore"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_dots"
                android:contentDescription="More actions" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

</LinearLayout>
