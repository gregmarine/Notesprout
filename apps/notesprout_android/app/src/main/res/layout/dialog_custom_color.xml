<?xml version="1.0" encoding="utf-8"?>
<!-- Custom ink colour. Three inputs onto one value, kept in sync by CustomColorDialog:
     the SV field + hue strip, the R/G/B sliders, and the hex field. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal">

        <com.notesprout.android.notebook.SvFieldView
            android:id="@+id/svField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.notesprout.android.notebook.HueStripView
            android:id="@+id/hueStrip"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- R / G / B. Sliders for coarse work, the numbers beside them for exact values. -->
    <LinearLayout
        android:id="@+id/rowRed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="R"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekRed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progressTint="@color/inkBlack"
            android:thumbTint="@color/inkBlack" />

        <TextView
            android:id="@+id/valRed"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="G"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progressTint="@color/inkBlack"
            android:thumbTint="@color/inkBlack" />

        <TextView
            android:id="@+id/valGreen"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="B"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekBlue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progressTint="@color/inkBlack"
            android:thumbTint="@color/inkBlack" />

        <TextView
            android:id="@+id/valBlue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Hex + a live preview of the result. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEX"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editHex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="7"
            android:singleLine="true"
            android:textColor="@color/inkBlack"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:importantForAutofill="no"
            android:hint="#000000"
            android:textColorHint="@color/inkLight"
            android:contentDescription="Ink colour as a hex value" />

        <View
            android:id="@+id/colorPreview"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:contentDescription="Preview of the chosen ink" />

    </LinearLayout>

    <!-- Shown only when the chosen colour sits under the overlay's brightness floor, where it would
         write as black on colour e-paper. Informational, never blocking. -->
    <TextView
        android:id="@+id/tvDimWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Too dark for colour e-paper — this will write as black. Try a brighter shade."
        android:textColor="@color/inkBlack"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
