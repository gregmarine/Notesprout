<?xml version="1.0" encoding="utf-8"?>
<!--
    One routine occurrence and its steps.

    Chrome mirrors activity_tasks.xml deliberately — nav row, then a titled row carrying the one
    create action — so moving between the task list and a routine needs nothing new learned. What is
    missing is the view toggles: a routine screen only ever shows a single occurrence.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- Nav row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/paperWhite"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRoutineBack"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Back to tasks" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="1dp" />

        <!-- The same sibling-surface pair, in the same order, as the tasks and day-window bars. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRoutineCalendar"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_calendar"
            android:contentDescription="Calendar" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRoutineScratchpad"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_sketching"
            android:contentDescription="Scratch Pad" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- Title row: the routine's name and deadline, and the one way to add a step. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvRoutineTitle"
            style="@style/TextAppearance.Notesprout.TitleLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/tvRoutineDue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textColor="@color/inkBlack"
            android:singleLine="true"
            android:text="" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnAddStep"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_plus"
            android:contentDescription="Add step" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/routineList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <TextView
            android:id="@+id/routineEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="15sp"
            android:textColor="@color/inkLight"
            android:visibility="gone"
            android:text="No steps yet" />
    </FrameLayout>

</LinearLayout>
