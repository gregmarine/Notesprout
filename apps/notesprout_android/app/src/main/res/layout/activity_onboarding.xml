<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite"
    android:fitsSystemWindows="true">

    <!-- Top border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱  Save your recovery key"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/inkBlack" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Your notes are encrypted. This recovery key is the one secret that unlocks them on a new device or after a reinstall. It is the only copy — write it down or save it in a password manager. We can't recover it for you."
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/inkBlack" />

            <TextView
                android:id="@+id/tvRecoveryKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/shape_bordered"
                android:padding="18dp"
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:letterSpacing="0.02"
                android:textColor="@color/inkBlack"
                android:text="NSPT-…" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopyKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Copy"
                android:textSize="16sp"
                android:textColor="@color/inkBlack"
                android:textAllCaps="false"
                android:background="@drawable/shape_bordered"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavedIt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="I've saved it"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/paperWhite"
                android:textAllCaps="false"
                android:background="@color/inkBlack"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSetPassphrase"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Set a memorable passphrase instead"
                android:textSize="15sp"
                android:textColor="@color/inkBlack"
                android:textAllCaps="false"
                android:background="@color/paperWhite"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

</LinearLayout>
