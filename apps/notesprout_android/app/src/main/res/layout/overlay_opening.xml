<?xml version="1.0" encoding="utf-8"?>
<!-- "Opening…" overlay — a centered bordered box floating over whatever is on screen. Shown by
     the source screen the moment a notebook open is requested (OpeningOverlay helper) and by
     NotebookActivity itself until the first page renders. The root is full-screen but transparent:
     it exists only to intercept all touches while visible (the slow e-ink refresh invites
     double-taps); the underlying screen stays visible, so only the box region repaints. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bordered"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opening…"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
