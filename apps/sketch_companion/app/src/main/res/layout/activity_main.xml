<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/panel_side"
        android:paddingEnd="@dimen/panel_side">

        <ImageButton
            android:id="@+id/btnCamera"
            style="@style/Widget.Companion.ToolbarButton"
            android:contentDescription="@string/action_camera"
            android:src="@drawable/ic_camera" />

        <ImageButton
            android:id="@+id/btnPhoto"
            style="@style/Widget.Companion.ToolbarButton"
            android:layout_marginStart="@dimen/panel_gap"
            android:contentDescription="@string/action_photo"
            android:src="@drawable/ic_photo" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSave"
            style="@style/Widget.Companion.ToolbarButton"
            android:layout_marginEnd="@dimen/panel_gap"
            android:contentDescription="@string/action_save"
            android:src="@drawable/ic_download" />

        <ImageButton
            android:id="@+id/btnShare"
            style="@style/Widget.Companion.ToolbarButton"
            android:contentDescription="@string/action_share"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <com.symmetricalpalmtree.sketchcompanion.ui.FrameView
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/frame_margin" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/panel_side"
        android:paddingTop="@dimen/panel_gap"
        android:paddingEnd="@dimen/panel_side"
        android:paddingBottom="@dimen/panel_gap">

        <com.symmetricalpalmtree.sketchcompanion.ui.LatchRow
            android:id="@+id/rowStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.symmetricalpalmtree.sketchcompanion.ui.LatchRow
            android:id="@+id/rowCountA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/panel_gap" />

        <com.symmetricalpalmtree.sketchcompanion.ui.LatchRow
            android:id="@+id/rowCountB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/panel_gap" />

        <com.symmetricalpalmtree.sketchcompanion.ui.LatchRow
            android:id="@+id/rowColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/panel_gap" />

        <com.symmetricalpalmtree.sketchcompanion.ui.LatchRow
            android:id="@+id/rowWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/panel_gap" />
    </LinearLayout>
</LinearLayout>
