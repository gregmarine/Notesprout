<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No launcher activity: the Supernote launcher lists the package anyway (accepted — "Ratta
         being Ratta"); everywhere else only Settings → Apps shows it. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ext_label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout">

        <!-- The DOCUMENT_EDITOR point (arc 19 / M3) — the second screen-owning point after
             SCRATCH_PAD. No Application class: this extension has no drawing engine to register.
             API version 6 (arc 22 / X4). M3 declared 2; X4 moves it because the extension store
             became real SQLite tables and `IExtensionStore` was REPLACED — the editor's per-device
             state is now the `prefs` / `word` / `caret` rows this service declares. That break runs
             both ways (a version-2 extension calling the old store interface would land on a
             different method), so the host accepts a store-taking service only at
             `MIN_API_VERSION_FOR_STORE` (6) and above; until this line said 6, every Document door
             on the device was gone by design. The two services below stay at 3 — meta-data is per
             service, and neither of them takes a store. The `android:value` below is the
             host-compat gate — it is the line that matters, and this comment must move with it. -->
        <service
            android:name=".DocumentEditorService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.DOCUMENT_EDITOR" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="6" />
        </service>

        <!-- The NOTEBOOK_IMPORTER point (arc 16 / I1), served here too since arc 19 / M8: `.md` /
             `.markdown` / `.txt` in, as a text document. A sibling of `:ext-soil`'s importer — same
             action, same stateless bind, different declared formats — and the host lists whatever
             is installed.
             API version 3 on THIS service alone (metadata is per-service; the editor above
             declares 6): the descriptor's result-kind tail is what tells the host these bytes are text,
             and a version-2 host would read the absent tail as ".soil" and run a Markdown file
             through the notebook probe. -->
        <service
            android:name=".TextImporterService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.NOTEBOOK_IMPORTER" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="3" />
        </service>

        <!-- The NOTEBOOK_EXPORTER point (arc 15 / E1), served here too since arc 19 / M9: the
             notebook's document out, as Markdown or plain text. The third exporter on the one
             point, beside `:ext-soil` and `:ext-pdf` — the host assembles the final text bytes and
             this service streams them verbatim.
             API version 3 on THIS service (metadata is per-service; the editor above declares 6):
             the descriptor declares the SOURCE_DOCUMENT source kind, and a version-2 host would
             fail its unmarshal on that unknown kind — a silent drop. Declaring 3 makes the skip
             happen at discovery instead, before any bind. -->
        <service
            android:name=".DocumentExporterService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.NOTEBOOK_EXPORTER" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="3" />
        </service>

        <!-- The extension-owned screen: exported, custom action, NO launcher filter; launched only
             by the host via startActivityForResult — it refuses any other caller first thing in
             onCreate. <category DEFAULT> is required or implicit resolution will not match it. -->
        <!-- `keyboard|keyboardHidden` in configChanges: pairing a Bluetooth keyboard is a
             configuration change, and losing an unsaved draft to one would be unforgivable.
             `adjustResize`: the soft keyboard shrinks the layout instead of covering the line being
             written — and on Ratta it must NEVER be hidden, because hardware keys are translated by
             the IME and delivered only while it is shown. -->
        <activity
            android:name=".DocumentEditorActivity"
            android:configChanges="keyboard|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateUnchanged|adjustResize">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.DOCUMENT_EDITOR_SCREEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
