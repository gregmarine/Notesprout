<?xml version="1.0" encoding="utf-8"?>
<!--
  The document editor screen (arc 19 / M4) — the real editor. Chrome, not paper: no PaperView, no
  exclusion rects, nothing to hand the EPD pipeline to (the M3 on-device answer: stop-behind is
  enough, the notebook needs no handoff around this screen).

  Shape, top to bottom:
    header  — Close · title · ‹ n / m › · Scope · Text size · Write · Preview · [Show pages]
              (no ✓ Done — see topBarRow; Show pages is text-document-only, M8)
    rule    — 1dp inkBlack
    writing chrome (source strip + format bar + overflow panel + find bar), hidden as ONE piece
              in Preview
    rule    — 1dp inkBlack
    editor  — the Markdown source, or the rendered preview in its place

  The format bar's buttons are NOT declared here: the overflow manager moves the real views between
  the bar and the panel, so a layout that listed them would describe an arrangement that stops being
  true the moment the bar is narrower than its contents. Both containers are in flow — the panel
  pushes the text down rather than floating over it, because an overlay ghosts on e-ink.

  M7 added the scope toggle to the header — page document ↔ the notebook's one merged draft. It is
  always visible; the page cluster it sits after is what goes GONE in the notebook scope, because
  `‹ n / m ›` numbers nothing there.

  Chrome sits flush at the top edge — the top guard is 0 on Ratta; the Activity still applies it,
  because the guard, not this file, is where that decision lives.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:orientation="vertical">

    <!-- One row, the app's own header idiom: the title DOCKED right after the back arrow (the
         library reads `← Notebooks / Test` the same way), weight-1 so it takes the slack and
         ellipsizes first; then the page cluster `‹ n / m ›`; then the trailing actions. Everything
         rides the row's center_vertical, so the title and the arrow can never disagree on a
         baseline — the M6-review complaint that killed the floated-centre arrangement.

         There is NO ✓ Done (user call, 2026-08-30): writing here is not cancellable and every way
         out saves, so the back arrow IS the leave door — a second button that did the same thing
         read as redundant. og keeps its ✓; SN diverges deliberately. M8's "show the pages" exit for
         text documents is therefore its OWN button at the trailing edge (btnShowPages), not a ✓:
         the back arrow still means "to the library", and that one means "open the pages". -->
    <LinearLayout
        android:id="@+id/topBarRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnClose"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/cd_document_close"
            android:src="@drawable/ic_arrow_left" />

        <!-- Also the rename control for a text document (M8): it is made clickable from code, and
             takes the row's full height so that the tap target is hand-sized rather than
             text-sized. No box, no underline — on e-ink there is no ripple to promise an
             affordance with, and a boxed title would read as a field rather than a heading; the
             long-press hint is what teaches it. -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/document_title"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

        <!-- The page arrows (M6), flanking the count they move. Never disabled and never hidden:
             at the first or last page they say so instead, because a disabled button is visually
             silent on e-ink. They work in Preview too — walking the notebook is reading as much
             as writing. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPagePrev"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/cd_document_page_prev"
            android:src="@drawable/ic_page_prev" />

        <!-- `n / m`. Smaller than the title rather than grey: it carries information, and
             information takes inkBlack and gets smaller to read as secondary. -->
        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/inkBlack"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPageNext"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/cd_document_page_next"
            android:src="@drawable/ic_page_next" />

        <!-- The scope toggle (M7): this page's document ↔ the notebook's one merged final draft.
             Immediately after the page cluster it replaces, because that is what it is an
             alternative to. ALWAYS visible — both scopes, Write and Preview: it is how the reader
             gets back, and a way back that vanishes in one of the two places is not one.

             The icon names WHERE THE TAP GOES, not where you are: a notebook while a page is open,
             a page while the notebook document is. Both faces are set from code, so this is only
             the page-scope starting state. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnScope"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/cd_document_scope_notebook"
            android:src="@drawable/ic_notebook" />

        <!-- Text size / Write / Preview at the trailing edge — the SN rule: action buttons on the
             TOP bar, after the cancel side. The armed mode's button carries the selected state of
             bg_toolbar_button (a 1dp inkBlack box), which is how every armed tool in this app
             reads. Text size stays live in Preview: reading comfort is what it is mostly for. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnTextSize"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_document_text_size"
            android:src="@drawable/ic_text_size" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnWrite"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/cd_document_write"
            android:src="@drawable/ic_pen" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPreview"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/cd_document_preview"
            android:src="@drawable/ic_eye" />

        <!-- Show pages (M8) — text documents only, and only in the notebook scope, which is where
             the page cluster is GONE and the width exists. It is NOT a second leave door: the back
             arrow still leaves to the library, and this one asks the host to open the pages behind
             the document instead. GONE by default and set from code, because before the first state
             lands there is no notebook to know anything about. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnShowPages"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:contentDescription="@string/document_show_pages"
            android:src="@drawable/ic_pages"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bar's bottom border. 1dp solid inkBlack — borderGray is invisible on e-ink. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- Writing chrome: hidden as one piece in Preview, where there is nothing to format. -->
    <LinearLayout
        android:id="@+id/writingChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The source strip (M6): where this document came from, and the only two acts that can
             change that. It is the FIRST child of the writing chrome, so Preview takes it away with
             the rest of the writing tools — provenance is a writer's concern.

             Reflow sits LEFT of Bring in so that Bring in keeps its position under the hand (og's
             order). Both are word buttons rather than glyphs — on e-ink words read better than
             icons, and there is room for two here — but they are HAND-SIZED, not find-bar-sized
             (the M6-review call): minHeight rides @dimen/toolbar_button_size like every other
             tappable control, because these two are tapped mid-writing, not mid-search.
             focusable="false" for the find bar's reason — the caret and the selection these act on
             belong to the editor. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <!-- "Drafted from this page" / "Page has changed since this draft" / "Not drafted from
                 this page". inkBlack, a step under the title: it carries information. -->
            <TextView
                android:id="@+id/sourceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/inkBlack"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/cd_document_reflow"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:minWidth="0dp"
                android:minHeight="@dimen/toolbar_button_size"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/document_reflow"
                android:textAllCaps="false"
                android:textColor="@color/inkBlack"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBringIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/cd_document_bring_in"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:minWidth="0dp"
                android:minHeight="@dimen/toolbar_button_size"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/document_bring_in"
                android:textAllCaps="false"
                android:textColor="@color/inkBlack"
                android:textSize="14sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <LinearLayout
            android:id="@+id/formatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp" />

        <!-- Where the bar's tail lands when it does not fit. Bordered, in flow, collapsed until
             asked for. -->
        <LinearLayout
            android:id="@+id/overflowPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_bordered"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Find & replace, hidden until Ctrl+F or the bar's search tool asks for it. Two rows:
             `[find][n of m][‹][›][✕]` over `[replace][Replace][All]`. Inside the writing chrome, so
             Preview takes it away with the rest of the writing tools.

             Every button here is focusable="false": the editor must keep the caret and the
             selection these act on — the selection IS the current match, and a button that stole
             the focus would take the highlight with it. -->
        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/inkBlack" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/findField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_bordered"
                    android:hint="@string/find_hint"
                    android:imeOptions="actionSearch|flagNoFullscreen|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:textColor="@color/inkBlack"
                    android:textColorHint="@color/inkLight"
                    android:textSize="14sp" />

                <!-- The running count. inkBlack and small rather than grey: it carries
                     information. minWidth so the row does not shuffle as the digits change. -->
                <TextView
                    android:id="@+id/findCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="@color/inkBlack"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnFindPrev"
                    style="@style/Widget.Notesprout.ToolbarButton"
                    android:contentDescription="@string/cd_find_prev"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:src="@drawable/ic_page_prev" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnFindNext"
                    style="@style/Widget.Notesprout.ToolbarButton"
                    android:contentDescription="@string/cd_find_next"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:src="@drawable/ic_page_next" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnFindClose"
                    style="@style/Widget.Notesprout.ToolbarButton"
                    android:contentDescription="@string/cd_find_close"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:src="@drawable/ic_x" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/replaceField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_bordered"
                    android:hint="@string/find_replace_hint"
                    android:imeOptions="actionSearch|flagNoFullscreen|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:textColor="@color/inkBlack"
                    android:textColorHint="@color/inkLight"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReplace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_toolbar_button"
                    android:contentDescription="@string/cd_find_replace_one"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:stateListAnimator="@null"
                    android:text="@string/find_replace_one"
                    android:textAllCaps="false"
                    android:textColor="@color/inkBlack"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReplaceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_toolbar_button"
                    android:contentDescription="@string/cd_find_replace_all"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:stateListAnimator="@null"
                    android:text="@string/find_replace_all"
                    android:textAllCaps="false"
                    android:textColor="@color/inkBlack"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- The source. Monospace because this is Markdown and columns carry meaning here.

         A ProofreadEditText rather than a plain field (M10): the spelling and grammar underlines
         are dashed and dotted, which no CharacterStyle can draw, so they are painted by the view
         itself — and the tap that opens a flagged word's popup is read from the same touch stream
         the caret is placed from. The find bar's two fields stay plain: nothing is checked there. -->
    <com.symmetricalpalmtree.notesproutsn.ext.document.ProofreadEditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/paperWhite"
        android:gravity="top|start"
        android:hint="@string/document_hint"
        android:imeOptions="flagNoFullscreen|flagNoExtractUi"
        android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
        android:lineSpacingMultiplier="1.2"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:scrollbars="vertical"
        android:textColor="@color/inkBlack"
        android:textColorHint="@color/inkLight"
        android:textSize="15sp"
        android:typeface="monospace" />

    <ScrollView
        android:id="@+id/previewScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/previewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp"
            android:textColor="@color/inkBlack"
            android:textIsSelectable="true"
            android:textSize="16sp" />

    </ScrollView>

</LinearLayout>
