<?xml version="1.0" encoding="utf-8"?>
<!--
  The extension's own strings. `ok` and `cancel` come from :sn-screen (Dialogs / ActionSheetDialog
  reference them from inside the module) and are deliberately not repeated here.
-->
<resources>
    <string name="ext_label">NSE · Document</string>
    <string name="document_title">Document</string>

    <!-- The editor's chrome. Every icon button needs a long-press hint naming it, and the hint is
         its content description. -->
    <string name="cd_document_close">Close</string>
    <string name="cd_document_write">Write</string>
    <string name="cd_document_preview">Preview</string>
    <string name="cd_document_text_size">Text size</string>
    <string name="document_load_failed">This document could not be read just now.</string>
    <!-- `n / m` beside the title. Empty for the notebook scope (M7), which is not a page. -->
    <string name="document_page_indicator">%1$d / %2$d</string>
    <string name="document_hint">Start writing…</string>

    <!-- Page flips (M6). The arrows are never disabled and never hidden: at an edge they say so,
         because a disabled button is visually silent on e-ink. A toast, and one of the sanctioned
         ones — it reports the state the notebook is already in, and the tap changed nothing. -->
    <string name="cd_document_page_prev">Previous page</string>
    <string name="cd_document_page_next">Next page</string>
    <string name="document_first_page">First page.</string>
    <string name="document_last_page">Last page.</string>

    <!-- The scope toggle (M7). The label names WHERE THE TAP GOES, not where the reader is: a
         two-state control that described its own state would need a second control to explain it,
         and this header has no room for one. -->
    <string name="cd_document_scope_notebook">Notebook document</string>
    <string name="cd_document_scope_page">Page document</string>

    <!-- The source strip (M6): where this document came from, and its two acts. -->
    <string name="document_source_drafted">Drafted from this page</string>
    <string name="document_source_stale">Page has changed since this draft</string>
    <string name="document_source_none">Not drafted from this page</string>
    <string name="document_reflow">Reflow</string>
    <string name="cd_document_reflow">Join wrapped lines into paragraphs  ·  Ctrl+Shift+F</string>
    <string name="document_bring_in">Bring in</string>
    <string name="cd_document_bring_in">Bring this page\'s text into the document</string>

    <!-- The same strip in the notebook scope (M7). "Not merged from these pages" has no line at
         all: the notebook document exists because the writer asked for it, and naming the absence
         of a merge would be noise about something they did on purpose. A page's document is the
         opposite case — it is normally drafted, so its absence is worth saying. -->
    <string name="document_source_merged">Merged from this notebook\'s pages</string>
    <string name="document_source_pages_stale">Pages have changed since this merge</string>
    <string name="document_merge">Merge</string>
    <string name="cd_document_merge">Merge the pages\' text into this document</string>

    <!-- Bring in: the choice is made BEFORE recognition runs, so there is never a "cancel after
         waiting" state. Both situations are real — a false start, and more ink written after the
         editing began. The notebook scope takes the same two rows under its own title. -->
    <string name="bring_in_title">Bring in</string>
    <string name="bring_in_replace">Replace this document</string>
    <string name="bring_in_append">Add below the current text</string>
    <string name="merge_title">Merge pages</string>

    <!-- Shown while the host reads: immediately for a Bring in / Merge (which always read in full)
         and only after 350 ms for a page flip or a scope switch, so a target that is already
         drafted arrives with no dialog flash. Never `cancelable` — back and an outside tap must
         not leave a read running unwatched — but the two that walk EVERY page (entering the
         notebook scope, and Merge) carry a real Cancel button. -->
    <string name="document_reading_page">Reading this page…</string>
    <string name="document_reading_pages">Reading the pages…</string>

    <!-- Bring in could not read the page. Two dialogs rather than one, because "there is no
         recognizer here" is something the reader can act on and "it failed" is not. -->
    <string name="document_seed_unavailable_title">Recognition isn\'t available</string>
    <string name="document_seed_unavailable_body">This page\'s handwriting could not be read: no recognizer is installed, or its language model has not been downloaded yet. Nothing was changed — the page can be brought in once recognition is ready.</string>
    <string name="document_seed_failed_title">Couldn\'t read this page.</string>
    <string name="document_seed_failed_body">Nothing was changed. Try again in a moment.</string>

    <!-- Format-bar hints: the tool's name and its chord, which is all an icon bar can teach. The
         separator is a spaced middle dot, matching every other hint in this family. -->
    <string name="fmt_h1">Heading 1  ·  Ctrl+1</string>
    <string name="fmt_h2">Heading 2  ·  Ctrl+2</string>
    <string name="fmt_h3">Heading 3  ·  Ctrl+3</string>
    <string name="fmt_bold">Bold  ·  Ctrl+B</string>
    <string name="fmt_italic">Italic  ·  Ctrl+I</string>
    <string name="fmt_strikethrough">Strikethrough  ·  Ctrl+Shift+X</string>
    <string name="fmt_code">Inline code  ·  Ctrl+E</string>
    <string name="fmt_quote">Blockquote  ·  Ctrl+Shift+Q</string>
    <string name="fmt_bullet">Bullet list  ·  Ctrl+Shift+8</string>
    <string name="fmt_ordered">Numbered list  ·  Ctrl+Shift+7</string>
    <string name="fmt_task">Task list  ·  Ctrl+Shift+9</string>
    <string name="fmt_link">Link  ·  Ctrl+K</string>
    <string name="fmt_image">Image  ·  Ctrl+Shift+K</string>
    <string name="fmt_rule">Horizontal rule  ·  Ctrl+Shift+−</string>
    <string name="fmt_search">Find &amp; replace  ·  Ctrl+F</string>
    <string name="fmt_word_count">Word count</string>
    <string name="fmt_more">More tools</string>

    <!-- Find &amp; replace. The count reads as a bare total until a match is stepped onto, and as
         `n of m` after that — where you are only exists once you are somewhere. -->
    <string name="find_hint">Find</string>
    <string name="find_replace_hint">Replace with</string>
    <string name="find_count">%1$d of %2$d</string>
    <string name="cd_find_prev">Previous match</string>
    <string name="cd_find_next">Next match  ·  Enter</string>
    <string name="cd_find_close">Close find</string>
    <string name="find_replace_one">Replace</string>
    <string name="cd_find_replace_one">Replace the current match, then find the next</string>
    <string name="find_replace_all">All</string>
    <string name="cd_find_replace_all">Replace every match — one edit, one Ctrl+Z</string>
    <string name="find_no_matches">No matches.</string>
    <string name="find_replaced">Replaced %1$d.</string>

    <!-- Word count. A toast, because it confirms a result that already exists — nothing failed. -->
    <string name="word_count_selection_prefix">"Selection: "</string>
    <string name="word_count_format">%1$,d words  ·  %2$,d characters</string>

    <!-- Reflow. Its control is the source strip's Reflow button (M6), and Ctrl+Shift+F is the same
         act from the keyboard. The message is the only thing it says when there was nothing to
         join. -->
    <string name="reflow_nothing">Nothing to reflow.</string>

    <!-- Text size. The tick marks the size in force; the choice outlives the showing. -->
    <string name="text_size_title">Text size</string>
    <string name="text_size_current">%1$s  ✓</string>
    <string name="text_size_small">Small</string>
    <string name="text_size_medium">Medium</string>
    <string name="text_size_large">Large</string>
    <string name="text_size_larger">Larger</string>
    <string name="text_size_largest">Largest</string>
</resources>
