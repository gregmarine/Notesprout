<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No launcher activity: the Supernote launcher lists the package anyway (accepted — "Ratta
         being Ratta"); everywhere else only Settings → Apps shows it. -->
    <application
        android:name=".ScratchPadApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ext_label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout">

        <!-- The SCRATCH_PAD point: the host holds one bind for the screen's whole showing. -->
        <service
            android:name=".ScratchPadService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.SCRATCH_PAD" />
            </intent-filter>
            <!-- 6 since arc 22 / X2: the pad's pages are rows in the host's table store, and a
                 store-taking point is accepted only at MIN_API_VERSION_FOR_STORE and above. -->
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="6" />
        </service>

        <!-- The extension-owned screen (tier 2): exported, custom action, NO launcher filter;
             launched only by the host for a result — it verifies its caller first thing in onCreate.
             <category DEFAULT> is required or implicit resolution will not match it. -->
        <activity
            android:name=".ScratchPadActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.SCRATCH_PAD_SCREEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
