<?xml version="1.0" encoding="utf-8"?>
<!--
  The extension's own strings. `ok` and `cancel` come from :sn-screen (Dialogs / ActionSheetDialog
  reference them from inside the module) and are deliberately not repeated here.
-->
<resources>
    <string name="ext_label">NSE · Scratch Pad</string>
    <string name="scratch_title">Scratch Pad</string>
    <string name="scratch_opening">Opening…</string>

    <!-- Chrome. Every icon button needs a hint naming it: long-press tooltip and content description. -->
    <string name="cd_scratch_back">Back</string>
    <string name="cd_tool_pen">Pen</string>
    <string name="cd_tool_eraser">Eraser</string>
    <string name="cd_tool_lasso">Lasso</string>
    <string name="cd_prev_page">Previous page</string>
    <string name="cd_next_page">Next page</string>
    <string name="scratch_page_indicator">%1$d / %2$d</string>

    <!-- Long-press sheet + its confirm. The bare wording is SN's notebook one: undo restores the
         ink, so naming it in the prompt would overstate what is lost. -->
    <string name="delete_page_action">Delete page</string>
    <string name="delete_page_title">Delete this page?</string>
    <string name="delete_confirm">Delete</string>
    <string name="delete_selection_action">Delete selection</string>

    <!-- Send (J5) — both buttons carry the pencil-down icon; they exist only when the pad was
         opened from a notebook. -->
    <string name="cd_scratch_send_page">Send page to notebook</string>
    <string name="cd_scratch_send_selection">Send selection to notebook</string>

    <!-- Problem dialogs — a tap that did nothing is never a toast on e-ink. -->
    <string name="scratch_store_failed_title">Scratch pad unavailable</string>
    <string name="scratch_store_failed_body">Notesprout SN could not open the scratch pad\'s storage. Nothing was lost — try again.</string>
    <string name="scratch_page_full_title">Page is full</string>
    <string name="scratch_page_full_body">This scratch page holds as much ink as it can. Start a new page to keep writing.</string>
    <string name="scratch_unreadable_title">Page unreadable</string>
    <string name="scratch_unreadable_body">This scratch page could not be read, so it is shown empty and left untouched — nothing will be written over it. Delete it to start again.</string>
    <string name="scratch_nothing_to_send_title">Nothing to send</string>
    <string name="scratch_nothing_to_send_body">There is no ink here to send to the notebook.</string>
</resources>
