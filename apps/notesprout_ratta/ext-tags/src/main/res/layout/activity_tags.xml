<?xml version="1.0" encoding="utf-8"?>
<!--
  The tag screen (arc 21 / W1) — the app's FIRST tier-2 screen with no paper on it, so there is no
  full-bleed surface, no exclusion rects and no EPD handoff: an ordinary vertical stack of chrome.

  Top to bottom, and the order is the reading order: what this target already carries · the field
  that adds to it · every tag the library knows, paged. Chrome sits flush at the top edge — the top
  guard is 0 on Ratta. Dividers are 1dp inkBlack; borderGray is invisible on the panel.

  The list band takes the leftover height (`layout_weight="1"`) and its rows are measured against
  it, so the page size is what actually fits. The pager below it is INVISIBLE, never GONE, when
  there is only one page — its space is never given back.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:orientation="vertical">

    <!-- A FrameLayout, not a weighted row: the title is centred on the SCREEN, so it stays put
         whatever flanks it (the bar-centring trap — a weight-centred title moves with its
         neighbours). -->
    <FrameLayout
        android:id="@+id/topBarRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/cd_tags_back"
            android:src="@drawable/ic_arrow_left" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- The target half: what this notebook / page carries now, and the field that adds to it.
         One container because MANAGE's overview (arc 21 / W2) has no single target to show — it is
         a list OF targets — and hiding six views one at a time is how one of them gets missed. -->
    <LinearLayout
        android:id="@+id/targetSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tapping a row takes the tag off THIS target; the tag itself stays in the library
             (it persists until it is explicitly deleted). -->
        <TextView
            android:id="@+id/targetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/inkBlack"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/targetTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/targetEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/tags_target_empty"
            android:textColor="@color/inkLight"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <!-- The add field. Its ⊕ is a field affordance, not screen chrome — this screen has no
             confirm button, because every edit has already happened by the time you can see it. -->
        <LinearLayout
            android:id="@+id/addRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/tags_add_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/inkBlack"
                android:textColorHint="@color/inkLight"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnAdd"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:contentDescription="@string/cd_tags_add"
                android:src="@drawable/ic_plus" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

    </LinearLayout>

    <TextView
        android:id="@+id/listLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/inkBlack"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/listEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/inkLight"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- The band. Rows are built in code and measured against this height — the page size is what
         actually fits, never a guess. -->
    <LinearLayout
        android:id="@+id/listBand"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- Pager only, centred on the SCREEN (bottom bars are pager-only — the F2 rule). -->
    <FrameLayout
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrevPage"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:contentDescription="@string/cd_tags_prev_page"
                android:src="@drawable/ic_page_prev" />

            <TextView
                android:id="@+id/pageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="56dp"
                android:singleLine="true"
                android:textColor="@color/inkBlack"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNextPage"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:contentDescription="@string/cd_tags_next_page"
                android:src="@drawable/ic_page_next" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
