<?xml version="1.0" encoding="utf-8"?>
<!--
  Snap to guides — Tabler "layout-align-left" (a rule down the left, two blocks aligned to it),
  with the rule broken into dashes so the icon shows what the page shows: a selection sitting
  against a guide.

  VectorDrawable has no dash effect, so each dash is a real segment and the caps are BUTT — the
  drawn length is the honest length. The stride is g-paper's snapGuidePaint (24/12): long dashes,
  which is exactly what a caught guide looks like on the canvas.

  The blocks stay SOLID on purpose. On the page the selection box is dashed too, but at 24dp with
  a 2-unit stroke a dashed rectangle is all corner and no rectangle — it reads as noise, not as a
  selection. The one dashed thing here is the guide, which is the thing the button is about.

  One icon for both states: the button's own selected border says whether snapping is armed,
  exactly as it does for Pen / Eraser / Lasso.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The guide: a long-dashed rule down the left edge. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="butt"
        android:pathData="M3 3l0 4 M3 10l0 4 M3 17l0 4"/>

    <!-- The selection: two blocks flush against the guide. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8 5a1 1 0 0 1 1 -1h10a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-10a1 1 0 0 1 -1 -1l0 -4"/>
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8 15a1 1 0 0 1 1 -1h5a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-5a1 1 0 0 1 -1 -1l0 -4"/>

</vector>
