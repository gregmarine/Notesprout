<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Notesprout" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="TextAppearance.Notesprout.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/inkBlack</item>
    </style>

    <style name="Widget.Notesprout.ElevatedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_elevated_background</item>
        <item name="android:textColor">@color/paperWhite</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.Notesprout.OutlinedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/shape_bordered</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Every icon button takes this — a tap target is dimen-driven, never hardcoded. -->
    <style name="Widget.Notesprout.ToolbarButton" parent="">
        <item name="android:layout_width">@dimen/toolbar_button_size</item>
        <item name="android:layout_height">@dimen/toolbar_button_size</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:padding">@dimen/toolbar_button_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Chrome text that carries no tap target — breadcrumb crumbs, "Cancel". -->
    <style name="Widget.Notesprout.TextButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- A word-labelled latch: exactly one of a row is down, and "down" is a thicker border. Used
         by the link picker's mode trio and its Style pair — words read better than glyphs on
         e-ink, and there is no icon for "this notebook" worth learning. -->
    <style name="Widget.Notesprout.LatchButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_selectable_card</item>
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- A yes/no pill (arc 24 / Z5b) — a `CompoundButton` whose whole appearance is its background,
         so nothing of AppCompat's switch track survives. The pill is 44 × 24dp; the view is wider
         and taller than that on purpose, so the thing being tapped is a real target and the pill is
         only what is drawn inside it. **The 56dp width is `toggle_pill`'s geometry too** — its knob
         insets are computed from it, so change both or neither. -->
    <style name="Widget.Notesprout.Toggle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">@dimen/toolbar_button_size</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/toggle_pill</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Notesprout.RadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textSize">16sp</item>
        <item name="android:button">@drawable/radio_selector</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- Air between the buttons (arc 24 / Z3, the user's eye): AppCompat's bar packs them 8dp
         apart, and "Keep editing" against "Discard" read as one control on the Nomad. The margin
         is a layout attr, honoured here because the bar inflates its buttons WITH this style. -->
    <style name="Widget.Notesprout.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/inkBlack</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

</resources>
