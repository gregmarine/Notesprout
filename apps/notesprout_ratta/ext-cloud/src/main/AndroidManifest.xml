<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The ONLY networked process in the app: the host has no INTERNET permission and never will
         (DRIVE_PLAN.md decision 3), and every other extension writes only to its host-lent store or
         streams the two fds it is handed. This permission exists so the V2 REST client and the
         connect screen's WebView PKCE flow can reach Google — nothing in V1 uses it yet.

         The package, the module and the label are generic (**NSE · Cloud Storage**, the rename of
         2026-09-05) because a second provider is baked in HERE beside Google Drive rather than
         shipped as a second extension — so this stays the one networked process however many
         providers it grows. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No launcher activity: the Supernote launcher lists the package anyway (accepted — "Ratta
         being Ratta"); everywhere else only Settings → Apps shows it. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ext_label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout">

        <!-- The CLOUD_STORAGE point (arc 25 / V1) — SN's EIGHTH capability point and a *generic*
             one: the contract speaks folders/files/bytes, never a provider's own terms. No
             Application class: this extension has no drawing engine to register.
             API version 8 — the point was born at 8 and floored at 8
             (`CloudContract.MIN_API_VERSION_FOR_CLOUD`; `ExtensionContract.MIN_API_VERSIONS`), so
             there is no older cloud shape a host could accept. The `android:value` below is the
             host-compat gate — it is the line that matters, and this comment must move with it. -->
        <service
            android:name=".CloudService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.CLOUD_STORAGE" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="8" />
        </service>

        <!-- The extension-owned connect screen (tier 2, V1 scaffold only): exported, custom action,
             NO launcher filter; launched only by the host for a result — it verifies its caller
             first thing in onCreate. <category DEFAULT> is required or implicit resolution will not
             match it. V1 has no WebView sign-in yet — see ConnectActivity's KDoc. -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.CLOUD_STORAGE_SCREEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
