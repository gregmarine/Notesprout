<?xml version="1.0" encoding="utf-8"?>
<!--
  The keypad (arc 24 / Z5b) — `KeypadDialog`'s content, behind the count row's More latch, and the
  one place a number outside 1–6 is typed. Styled through `Dialogs.style` like every other dialog
  here: the window's own `shape_dialog_bordered` is the white and the border, so this root paints
  nothing.

  A preview line over `1 2 3 / 4 5 6 / 7 8 9 / ⌫ 0 ✓`. **Done is in the grid, not on the button
  bar**: the thumb is already there, and the dialog's own buttons are Cancel alone — a positive
  button beside a ✓ would be two doors to one answer.

  Every cell is `0dp` wide with weight 1 so the three columns are equal whatever the dialog's width
  turns out to be, and `toolbar_button_size` tall — the digit buttons override
  `OutlinedButton`'s missing size (the arc-23 inflate trap) and the two icon buttons override
  `ToolbarButton`'s fixed width, which would otherwise ignore the weight.

  The digits are not strings — a digit is not a word. `KeypadDialog` writes them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/inkBlack"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key1"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key2"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key3"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key4"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key5"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key6"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key7"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key8"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key9"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/keyBackspace"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_width="0dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_keypad_backspace"
            android:src="@drawable/ic_backspace" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key0"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/keyDone"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:layout_width="0dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_keypad_done"
            android:src="@drawable/ic_check" />

    </LinearLayout>

</LinearLayout>
