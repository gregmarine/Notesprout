<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SnApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout"
        android:allowBackup="false">

        <!-- The launcher gate and the only thing that opens the global index. noHistory: it
             finishes itself once it has forwarded, so it is never on the back stack. -->
        <activity
            android:name=".bootstrap.BootstrapActivity"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".bootstrap.RecoveryKeyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".bootstrap.UnlockActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".library.LibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".library.NewNotebookActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".library.FolderPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".notebook.NotebookActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
