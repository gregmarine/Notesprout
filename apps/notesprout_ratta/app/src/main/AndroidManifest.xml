<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The readiness flow's offline pre-check (ML Kit's model download hangs silently offline). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package-visibility for SN's three extension points (API 30+ filtering). The scratch pad
         needs both: the service to discover and bind, the screen to resolve and launch for a
         result. -->
    <queries>
        <intent>
            <action android:name="com.symmetricalpalmtree.notesproutsn.extension.HANDWRITING_RECOGNIZER" />
        </intent>
        <intent>
            <action android:name="com.symmetricalpalmtree.notesproutsn.extension.SCRATCH_PAD" />
        </intent>
        <intent>
            <action android:name="com.symmetricalpalmtree.notesproutsn.extension.SCRATCH_PAD_SCREEN" />
        </intent>
        <intent>
            <action android:name="com.symmetricalpalmtree.notesproutsn.extension.NOTEBOOK_EXPORTER" />
        </intent>
    </queries>

    <application
        android:name=".SnApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Notesprout"
        android:allowBackup="false">

        <!-- The launcher gate and the only thing that opens the global index. noHistory: it
             finishes itself once it has forwarded, so it is never on the back stack. -->
        <activity
            android:name=".bootstrap.BootstrapActivity"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".bootstrap.RecoveryKeyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".bootstrap.UnlockActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".library.LibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".library.NewNotebookActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".templates.TemplatesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".library.FolderPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".notebook.NotebookActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Export (arc 15 / E1). Reached only from the library's notebook long-press sheet;
             receives EXTRA_NOTEBOOK_ID / _NAME and nothing else. -->
        <activity
            android:name=".export.ExportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".notebook.LinkPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
