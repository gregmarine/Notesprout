<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher glyph: the Tabler "seedling", mirrored horizontally — Notesprout SN's own mark,
     distinct at a glance from Notesprout Paper's while sharing the same ink-black outline
     vocabulary. Adaptive-icon 108dp viewport; the glyph is Tabler's 24-unit grid × 3.4 centred at
     54 (matches Ratta's own icon scale), then flipped left-right about its own centre so the stem
     and leaves face the opposite way. Strokes are in Tabler units (2 per 24) and scale with the
     group. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="-1"
        android:pivotX="54"
        android:pivotY="54">
        <group
            android:translateX="13.2"
            android:translateY="13.2"
            android:scaleX="3.4"
            android:scaleY="3.4">
            <path
                android:fillColor="@android:color/transparent"
                android:strokeColor="#000000"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M12 10a6 6 0 0 0 -6 -6h-3v2a6 6 0 0 0 6 6h3" />
            <path
                android:fillColor="@android:color/transparent"
                android:strokeColor="#000000"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M12 14a6 6 0 0 1 6 -6h3v1a6 6 0 0 1 -6 6h-3" />
            <path
                android:fillColor="@android:color/transparent"
                android:strokeColor="#000000"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M12 20l0 -10" />
        </group>
    </group>
</vector>
