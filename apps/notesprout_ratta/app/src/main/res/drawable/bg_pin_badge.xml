<?xml version="1.0" encoding="utf-8"?>
<!-- The pin badge's chip: solid paperWhite so the glyph never sits on a lined/dotted cover, with
     a 1dp inkBlack outline (borderGray is invisible on e-ink). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paperWhite" />
    <stroke android:width="1dp" android:color="@color/inkBlack" />
    <corners android:radius="4dp" />
</shape>
