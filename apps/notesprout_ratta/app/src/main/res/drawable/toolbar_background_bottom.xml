<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom chrome bar: paperWhite with a 1dp inkBlack line along its TOP edge only.
     The stroke rect is pushed outside the view on the other three sides by negative
     insets, so only the top edge of the stroke lands inside the bounds. borderGray is
     invisible on e-ink — a visible divider is always inkBlack. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paperWhite" />
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/inkBlack" />
        </shape>
    </item>
</layer-list>
