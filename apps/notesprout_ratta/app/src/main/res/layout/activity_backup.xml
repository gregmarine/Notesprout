<?xml version="1.0" encoding="utf-8"?>
<!-- Backup (arc 17 / K2): one screen — where backups go, the button that runs one, and what the
     last run did.

     The chrome follows F2: "Back up now" is the action and lives in the TOP bar, at its right
     edge, next to the back arrow and title — the same shape as Export's top bar. "Choose…" stays
     a body control, under the folder it changes. The bar is a LinearLayout because nothing in it
     is centred — the weight-centring trap (F2) only bites when something has to *look* centred.

     Neither button is ever disabled: on e-ink a disabled control is invisible, so both always look
     live and a tap that cannot work explains itself in a dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:text="@string/backup_title"
            android:textColor="@color/inkBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRun"
            style="@style/Widget.Notesprout.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/backup_run" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_folder_caption"
                android:textColor="@color/inkBlack"
                android:textSize="13sp" />

            <!-- The chosen folder, or "No folder chosen". Secondary text stays inkBlack and gets
                 smaller — inkLight is reserved for text meant NOT to be read, and where the
                 backups go is the one thing on this screen that must be. -->
            <TextView
                android:id="@+id/folderPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/inkBlack"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChoose"
                style="@style/Widget.Notesprout.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/backup_choose" />

            <!-- Cloud (arc 25 / V2, DRIVE_PLAN decision 8): where a cloud provider is offered, and
                 the only place in the app where an account is connected or forgotten.

                 The whole block is GONE unless a trusted provider is installed — re-asked on every
                 onResume, because a package can be disabled or replaced under a standing screen.
                 Never disabled: on e-ink a disabled control is invisible and reads as broken.

                 One button, whose text flips between Connect and Disconnect by status. It is a body
                 control rather than a top-bar action for the same reason "Choose…" is: it changes
                 the thing written directly above it, and the top bar belongs to "Back up now". -->
            <LinearLayout
                android:id="@+id/cloudSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloud_caption"
                    android:textColor="@color/inkBlack"
                    android:textSize="13sp" />

                <!-- The account line. Secondary text stays inkBlack and gets smaller — inkLight is
                     for text meant NOT to be read, and which account the backups go to is the one
                     thing here that must be. -->
                <TextView
                    android:id="@+id/cloudStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/inkBlack"
                    android:textSize="16sp" />

                <!-- The device folder (arc 25 / V4): every device that backs up to this account
                     gets its own folder under Backups/, so two devices never write over each
                     other. Minted here the first time this section renders, then it is the
                     person's — Rename… is a body control, under the line it changes, for the same
                     reason "Choose…" is. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cloud_device_folder_caption"
                    android:textColor="@color/inkBlack"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cloudFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/inkBlack"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCloudRename"
                    style="@style/Widget.Notesprout.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cloud_device_folder_rename" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cloudEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="@dimen/toolbar_button_size"
                    android:textColor="@color/inkBlack"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCloudConnect"
                    style="@style/Widget.Notesprout.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cloud_connect" />

                <!-- The cloud's own status line, at the section's foot — the local one is at the
                     foot of the screen, and each says what its own destination last received. -->
                <TextView
                    android:id="@+id/cloudLast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/inkBlack"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/inkBlack"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
