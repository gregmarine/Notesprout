<?xml version="1.0" encoding="utf-8"?>
<!-- Template options (arc 13 / G2) — a generator's recipe, adjustable, with the page it draws
     shown beside it. Two columns because the screen is portrait and so is the page: the preview
     keeps the page's own aspect at ~300 dp wide, and the controls take the fixed 420 dp beside it,
     which is what a label + [−] + value + [+] measures on the tablet tier (62 dp tap targets).

     The control column is in a ScrollView it should never need: the tallest kind (Dotted) comes to
     about 810 dp against ~855 dp of body on a Nomad. It is there so a longer translation cannot
     push a control off the bottom where nobody can reach it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:textSize="18sp"
            android:textColor="@color/inkBlack"
            android:maxLines="1"
            android:ellipsize="end" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnClose"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_x"
            android:contentDescription="@string/cd_close_options" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/previewFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_template_preview" />

        </FrameLayout>

        <ScrollView
            android:id="@+id/controlScroll"
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Spacing or count: the same axis, said two different ways. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/options_density"
                        android:textSize="15sp"
                        android:textColor="@color/inkBlack" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnModeSpacing"
                        style="@style/Widget.Notesprout.LatchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/toolbar_button_size"
                        android:minWidth="96dp"
                        android:text="@string/options_mode_spacing" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnModeCount"
                        style="@style/Widget.Notesprout.LatchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/toolbar_button_size"
                        android:layout_marginStart="6dp"
                        android:minWidth="96dp"
                        android:text="@string/options_mode_count" />

                </LinearLayout>

                <include
                    android:id="@+id/stepRows"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/stepCols"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/stepTop"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/stepBottom"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/stepLeft"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/stepRight"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <!-- Three ways to say "the same as that one" — the whole reason four independent
                     insets are not four times the work. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCopyAll"
                        style="@style/Widget.Notesprout.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/toolbar_button_size"
                        android:layout_weight="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/options_copy_all" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCopySides"
                        style="@style/Widget.Notesprout.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/toolbar_button_size"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/options_copy_sides" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCopyEnds"
                        style="@style/Widget.Notesprout.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/toolbar_button_size"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/options_copy_ends" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkMarginRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="@dimen/toolbar_button_size"
                    android:text="@string/options_margin_rule"
                    android:textSize="15sp"
                    android:textColor="@color/inkBlack" />

                <include
                    android:id="@+id/stepThickness"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/stepDot"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/stepShade"
                    layout="@layout/view_option_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- Cancel · Use once · Save as template… — Use once is GONE when nothing is waiting for a
         pick, never disabled: a greyed control is invisible on e-ink and reads as broken. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Notesprout.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:text="@string/cancel"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUseOnce"
            style="@style/Widget.Notesprout.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:text="@string/options_use_once"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            style="@style/Widget.Notesprout.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_marginStart="12dp"
            android:text="@string/options_save_as"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
