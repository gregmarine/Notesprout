<?xml version="1.0" encoding="utf-8"?>
<!-- Encryption (arc 26 / U1 + U3): the one screen where a person can SEE the secret that opens the
     library, replace it and drop it from this device. Backup's shape: back arrow + title on the
     top bar, a 1dp rule, a scrolling body of captions and outlined buttons.

     Every control is a door to a dialog, so the top bar carries no action of its own. The resume
     banner (U3) sits above the status lines and only exists while a rotation marker does — while
     it shows, Change passphrase and Forget are GONE, because neither is a safe thing to start on
     top of a half-finished rotation. Nothing here is ever disabled: on e-ink a disabled control is
     invisible and reads as broken. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:text="@string/encryption_title"
            android:textColor="@color/inkBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Resume (U3, resume path 1): a passphrase change that stopped between files. Only
                 exists while the marker does; Change passphrase and Forget are GONE beside it. -->
            <LinearLayout
                android:id="@+id/resumeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/encryption_resume_banner"
                    android:textColor="@color/inkBlack"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnResume"
                    style="@style/Widget.Notesprout.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/encryption_resume" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/inkBlack" />
            </LinearLayout>

            <!-- Status. Both lines carry information, so they stay inkBlack; the count is the
                 smaller of the two. The count reads the index's keyScope column — honest from U4
                 on, and "every notebook" until then. -->
            <TextView
                android:id="@+id/keyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/encryption_key_set"
                android:textColor="@color/inkBlack"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/keyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/inkBlack"
                android:textSize="13sp" />

            <!-- Reveal: the dialog shows the key in monospace with Copy / Close. No re-authentication
                 (decision 7) — the device PIN is the gate. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReveal"
                style="@style/Widget.Notesprout.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/encryption_reveal" />

            <!-- Change passphrase… (U3): verify the current key, pick or generate the new one,
                 confirm the backups warning, then the whole library is re-keyed under a progress
                 dialog and the app relaunches. GONE while a rotation is already in progress. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChange"
                style="@style/Widget.Notesprout.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/encryption_change" />

            <!-- Forget: confirm dialog, then the cached key and every raw key leave this device and
                 the app closes; the next launch is Unlock (decision 6, ships in release). -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnForget"
                style="@style/Widget.Notesprout.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/encryption_forget" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
