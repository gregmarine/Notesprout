<?xml version="1.0" encoding="utf-8"?>
<!-- Arc 26 / U4: the one "this notebook's passphrase" dialog (NotebookPassphrasePrompt). Unlock's
     shape in a dialog: the entry row is GONE while the notebook's attempt bucket is locked out and
     the countdown takes its place; a wrong entry keeps the dialog and shows the inline error. The
     IME is never hidden from here — on Ratta a hardware keyboard types only while it is shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/inkBlack"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/entryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_bordered"
            android:padding="12dp"
            android:hint="@string/notebook_passphrase_hint"
            android:textColorHint="@color/inkLight"
            android:textColor="@color/inkBlack"
            android:textSize="16sp"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:imeOptions="actionGo"
            android:saveEnabled="false"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notebook_passphrase_wrong"
            android:textColor="@color/inkBlack"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notebook_passphrase_checking"
            android:textColor="@color/inkBlack"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/lockoutText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/inkBlack"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
