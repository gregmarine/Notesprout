<?xml version="1.0" encoding="utf-8"?>
<!-- One page in the link picker's page grid: the page in miniature over its number (and its
     topmost heading, when it has one). The miniature's 1px border is drawn on the preview bitmap
     itself (PagePreview) — a background on the band gets overpainted by the fit-centred paper
     wherever the two disagree (eye-check #7), so the band carries no border of its own and a
     still-rendering card is simply blank until its preview lands. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_selectable_card"
    android:padding="4dp">

    <ImageView
        android:id="@+id/pagePreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/pageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/inkBlack"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp" />
</LinearLayout>
