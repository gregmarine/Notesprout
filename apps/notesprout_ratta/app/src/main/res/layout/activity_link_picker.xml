<?xml version="1.0" encoding="utf-8"?>
<!-- The link target picker. Four bands under one another, all of them fixed: title + path on top,
     the mode trio, the card grid (paginated, never scrolling — the library's rule), then Style and
     the pager + OK. Nothing here scrolls except the breadcrumb, which is a path, not content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <!-- "Link to…" / "Edit link" + the browse path + Cancel -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnUp"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_up_folder"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/breadcrumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Notesprout.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- The mode trio: what kind of thing this link points at. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeThisNotebook"
            style="@style/Widget.Notesprout.LatchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/link_mode_this_notebook" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeNotebook"
            style="@style/Widget.Notesprout.LatchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/link_mode_notebook" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeNotebookPage"
            style="@style/Widget.Notesprout.LatchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/link_mode_notebook_page" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="16sp"
            android:textColor="@color/inkBlack"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Style: how the link marks itself on the page. Underline or nothing — the locked pair. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_style_label"
            android:textSize="14sp"
            android:textColor="@color/inkBlack"
            android:paddingEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStyleUnderline"
            style="@style/Widget.Notesprout.LatchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/link_style_underline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStyleNone"
            style="@style/Widget.Notesprout.LatchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_style_none" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/toolbar_background_bottom">

        <LinearLayout
            android:id="@+id/pager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFirst"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="@string/cd_first_page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_prev_page" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/inkBlack" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNext"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_next_page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnLast"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_last"
                android:contentDescription="@string/cd_last_page" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOk"
            style="@style/Widget.Notesprout.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/ok" />
    </LinearLayout>

</LinearLayout>
