<?xml version="1.0" encoding="utf-8"?>
<!-- One template in the Templates grid: the paper in true miniature over its name. The 1px border
     is drawn on the miniature bitmap itself (TemplateThumbnails) — a background on the band gets
     overpainted by the fit-centred page wherever the two disagree, exactly as on a page card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_selectable_card"
    android:padding="4dp">

    <ImageView
        android:id="@+id/templatePreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/templateName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/inkBlack"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp" />
</LinearLayout>
