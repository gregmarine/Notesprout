<?xml version="1.0" encoding="utf-8"?>
<!--
  Notebook screen: full-bleed paper with chrome overlaid on top.
  PaperView (g-paper drawing surface) is added into paperContainer programmatically.
  Both bars (topBar's own bar + bottomStrip) and any open panel (penPanel/eraserPanel/lassoPanel)
  are pushed to paper.setExclusionRects after layout so ink never lands under chrome.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite">

    <FrameLayout
        android:id="@+id/paperContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@color/paperWhite">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/cd_back"/>

            <View
                android:layout_width="12dp"
                android:layout_height="0dp"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPen"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_pen"
                android:contentDescription="@string/cd_tool_pen"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnEraser"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_eraser"
                android:contentDescription="@string/cd_tool_eraser"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnLasso"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_lasso"
                android:contentDescription="@string/cd_tool_lasso"/>

        </LinearLayout>

        <!-- Bar's bottom border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack"/>

        <LinearLayout
            android:id="@+id/penPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/paperWhite"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_label_width"
                android:textSize="12sp"
                android:textColor="@color/inkBlack"/>

            <!-- Width buttons added in code -->
            <LinearLayout
                android:id="@+id/penWidthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_label_style"
                android:textSize="12sp"
                android:textColor="@color/inkBlack"/>

            <!-- Style buttons added in code -->
            <LinearLayout
                android:id="@+id/penStyleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_label_ink"
                android:textSize="12sp"
                android:textColor="@color/inkBlack"/>

            <!-- Ink swatches (row 1 of 2) added in code -->
            <LinearLayout
                android:id="@+id/inkRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

            <!-- Ink swatches (row 2 of 2) added in code -->
            <LinearLayout
                android:id="@+id/inkRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"/>

            <!-- Panel's own bottom border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/inkBlack"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/eraserPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/paperWhite"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_label_eraser"
                android:textSize="12sp"
                android:textColor="@color/inkBlack"/>

            <!-- Eraser radius buttons added in code -->
            <LinearLayout
                android:id="@+id/eraserRadiusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/inkBlack"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lassoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/paperWhite"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_label_pen_gestures"
                android:textSize="12sp"
                android:textColor="@color/inkBlack"/>

            <!-- Smart-lasso / scribble-erase toggles added in code -->
            <LinearLayout
                android:id="@+id/lassoToggleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/inkBlack"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/paperWhite">

        <!-- Strip's top border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/notebookName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/inkBlack"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/pageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/inkBlack"
                android:singleLine="true"
                android:paddingStart="16dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
