<?xml version="1.0" encoding="utf-8"?>
<!-- Contents (table of contents): one layout for both forms — the dialog owner branches in code
     on window width to pick full-screen vs. a left sidebar (panel width set from code; the back
     arrow shows only in the full-screen form). Header + divider · rows (paginated) · divider ·
     truncated line + pager. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contentsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/contentsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/shape_contents_sidebar"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnContentsBack"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/cd_back" />

            <TextView
                android:id="@+id/contentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/contents_title"
                android:textColor="@color/inkBlack"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <FrameLayout
            android:id="@+id/contentsBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/contentsRows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/contentsEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/contents_empty"
                android:textColor="@color/inkBlack"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <TextView
            android:id="@+id/contentsTruncated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textColor="@color/inkBlack"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/contentsPager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnContentsFirst"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="@string/cd_first_page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnContentsPrev"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_prev_page" />

            <TextView
                android:id="@+id/contentsPageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/inkBlack" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnContentsNext"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_next_page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnContentsLast"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_last"
                android:contentDescription="@string/cd_last_page" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
