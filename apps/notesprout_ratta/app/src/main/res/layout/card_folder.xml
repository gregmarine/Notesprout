<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_selectable_card"
    android:gravity="center"
    android:padding="8dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_folder"
        android:scaleType="fitCenter"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/folderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/inkBlack"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <!-- Where the folder is (arc 20). GONE everywhere but the search shelf, which is flat: two
         folders called "Notes" in two different places are otherwise the same card twice. Smaller
         and still inkBlack — secondary text that is meant to be read never takes inkLight. -->
    <TextView
        android:id="@+id/folderParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/inkBlack"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>
