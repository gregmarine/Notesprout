<?xml version="1.0" encoding="utf-8"?>
<!-- R0 scaffold placeholder — replaced by the real library/notebook flow in R1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Notesprout.HeadlineLarge" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="R0 scaffold"
        android:textAppearance="@style/TextAppearance.Notesprout.BodyMedium" />

</LinearLayout>
