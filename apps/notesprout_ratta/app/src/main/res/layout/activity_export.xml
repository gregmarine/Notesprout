<?xml version="1.0" encoding="utf-8"?>
<!-- Export (arc 15 / E1): one screen — who exports it, how, and the button that does it.

     The chrome follows F2: the action lives in the TOP bar, at its right edge, and the bottom of
     the screen holds nothing. The bar is a LinearLayout because nothing in it is centred — the
     back arrow, the title block and the action sit in reading order — and the weight-centred trap
     only bites when something has to *look* centred.

     Everything below the rule is built in code: the row count is the content (how many exporters
     are installed, how many options each declares), the way the action sheet's rows are. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_title"
                android:textColor="@color/inkBlack"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Secondary text stays inkBlack and gets smaller; inkLight is for text meant not to
                 be read, and the notebook's name is the one thing here that must be. -->
            <TextView
                android:id="@+id/notebookName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/inkBlack"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnExport"
            style="@style/Widget.Notesprout.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/export_action" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- The inline busy state. GONE until an export is actually running — a control that says
         nothing is better than one that lies, and on e-ink a toast for this would be missed. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/export_exporting"
        android:textColor="@color/inkBlack"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/formatCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_format_caption"
                android:textColor="@color/inkBlack"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/chooser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
