<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <!-- Breadcrumb bar. Flush at the top edge: on Ratta the top guard is 0 (no status-bar hazard). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Back out of a shelf. Far left, before the title, and the same left arrow as
             Go-up-a-folder: in a shelf that arrow is the only way back, so it reads as back. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCloseMode"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_close_mode"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnUp"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_up_folder"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/breadcrumbScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/breadcrumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- Pinned / Recents replace the breadcrumbs while a mode is on: there is no path to
             show, only a shelf. Exactly one of breadcrumbScroll / modeTitle is ever visible. -->
        <TextView
            android:id="@+id/modeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp"
            android:textColor="@color/inkBlack"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Create / view controls: the top bar's right edge is where everything you do
             *to* the library lives. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewNotebook"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_notebook_plus"
            android:contentDescription="@string/cd_new_notebook" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewFolder"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_folder_plus"
            android:contentDescription="@string/cd_new_folder" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRecents"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_clock"
            android:contentDescription="@string/cd_recents" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPinned"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_pinned"
            android:contentDescription="@string/cd_pinned" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSort"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_sort"
            android:contentDescription="@string/cd_sort" />

        <!-- The Scratch Pad (arc 11). GONE unless a trusted extension is installed —
             ScratchPadEntry owns it, re-discovering on every resume. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnScratchPad"
            style="@style/Widget.Notesprout.ToolbarButton"
            android:src="@drawable/ic_sketching"
            android:visibility="gone"
            android:contentDescription="@string/cd_scratch_pad" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <!-- Card grid. Cards are added programmatically; emptyState is a sibling that must survive
         every bind (LibraryGrid removes only the GridLayout it added last). -->
    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/library_empty"
            android:textSize="16sp"
            android:textColor="@color/inkBlack" />
    </FrameLayout>

    <!-- |< < n/n > >|                                                   [Templates] [debug ⋯] -->
    <!-- A FrameLayout, not a row: the pager is centred on the SCREEN, not on the space left over
         beside the right-hand group — whose width differs between debug and release, since the ⋯
         is only there in debug. -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:background="@drawable/toolbar_background_bottom">

        <LinearLayout
            android:id="@+id/pager"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFirst"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="@string/cd_first_page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_prev_page" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/inkBlack" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNext"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_next_page" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnLast"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_page_last"
                android:contentDescription="@string/cd_last_page" />
        </LinearLayout>

        <!-- Templates, then the debug ⋯ — DebugMenu appends into this same group at runtime
             (no-op in release, where the group is just Templates). -->
        <LinearLayout
            android:id="@+id/bottomRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Templates (arc 13) — the template library, the one screen behind every paper
                 decision. Always present: the three built-in papers need no extension and no data. -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnTemplates"
                style="@style/Widget.Notesprout.ToolbarButton"
                android:src="@drawable/ic_template"
                android:contentDescription="@string/cd_templates" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
