<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/inkBlack" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/unlock_body"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/inkBlack" />

            <LinearLayout
                android:id="@+id/entryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/keyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_bordered"
                    android:padding="18dp"
                    android:hint="@string/unlock_hint"
                    android:textColorHint="@color/inkLight"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:textColor="@color/inkBlack"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:imeOptions="actionGo"
                    android:maxLines="2" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUnlock"
                    style="@style/Widget.Notesprout.ElevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toolbar_bar_thickness"
                    android:layout_marginTop="16dp"
                    android:text="@string/unlock_button"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/unlock_checking"
                android:textSize="16sp"
                android:textColor="@color/inkBlack"
                android:visibility="gone" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/unlock_wrong"
                android:textSize="16sp"
                android:textColor="@color/inkBlack"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lockoutText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="16sp"
                android:textColor="@color/inkBlack"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

</LinearLayout>
