<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the floating selection toolbar (arc 4 / H2): included twice in activity_notebook.xml
     (the toolbar and its sub-toolbar). Buttons are added in code by SelectionToolbar; the row floats
     over the paper (2dp border — the floating-window weight), GONE until a selection exists, and is
     positioned with FrameLayout margins by ToolbarAnchor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_dialog_bordered"
    android:padding="4dp"
    android:visibility="gone" />
