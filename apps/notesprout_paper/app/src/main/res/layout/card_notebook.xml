<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bordered"
    android:padding="4dp">

    <!-- Cover image (or template placeholder), with an optional pin badge overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/paperWhite" />

        <ImageView
            android:id="@+id/pinBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:padding="2dp"
            android:src="@drawable/ic_pinned"
            android:background="@drawable/bg_pin_badge"
            android:contentDescription="@string/cd_pinned"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/inkBlack"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/cardDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/inkLight"
        android:singleLine="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
